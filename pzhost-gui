class WorldPage(Adw.Bin):
    def __init__(self, app):
        super().__init__()
        self.app = app
        page = Adw.PreferencesPage()
        self.set_child(page)

        g = Adw.PreferencesGroup(title="Save")
        r = Adw.ActionRow(title="Save the world now", subtitle="The server also saves by itself every few minutes")
        r.add_suffix(row_button("Save now", lambda: app.with_sudo(lambda: app.query(
            ["save"], lambda rc, out: app.win.toast("World saved" if rc == 0 else "Server is not running")))))
        g.add(r)
        r = Adw.ActionRow(title="Make a backup now", subtitle="Automatic backups run every day at 05:00 (kept 7 days)")
        r.add_suffix(row_button("Back up", lambda: app.run_task("Backing up the world", ["backup"],
                                                                on_done=lambda *_: self.load())))
        g.add(r)
        page.add(g)

        self.bg = Adw.PreferencesGroup(title="Backups",
                                       description="Go back in time: restoring replaces the current world "
                                                   "(the current world is backed up first)")
        self.bg.set_header_suffix(row_button("", self.load, "flat", icon="view-refresh-symbolic"))
        self.backup_rows = []
        page.add(self.bg)

        d = Adw.PreferencesGroup(title="Start over")
        r = Adw.ActionRow(title="Start a new world",
                          subtitle="New map, everyone makes a new character. Usernames, passwords and settings "
                                   "are kept. The old world is moved aside, not deleted.", subtitle_lines=3)
        r.add_suffix(row_button("New world…", self.new_world, "destructive-action"))
        d.add(r)
        page.add(d)

    def on_shown(self):
        self.load()

    def load(self):
        def done(rc, out):
            for r in self.backup_rows:
                self.bg.remove(r)
            self.backup_rows = []
            items = [l.split("|") for l in out.splitlines() if l.count("|") == 2]
            if not items:
                r = Adw.ActionRow(title="No backups yet")
                self.bg.add(r)
                self.backup_rows.append(r)
            for name, size, date in items[:20]:
                r = Adw.ActionRow(title=date, subtitle=f"{name} · {size}")
                r.add_suffix(row_button("Restore", lambda n=name, d=date: self.restore(n, d)))
                self.bg.add(r)
                self.backup_rows.append(r)
        self.app.with_sudo(lambda: self.app.query(["backups"], done))

    def restore(self, name, date):
        self.app.confirm("Restore this backup?",
                         f"The world goes back to {date}. Everything after that is lost "
                         "(the current world is backed up first). The server restarts.",
                         "Restore", lambda: self.app.run_task("Restoring backup", ["restore", name, "--yes"],
                                                              on_done=lambda *_: self.load()), destructive=True)

    def new_world(self):
        dlg = Adw.AlertDialog(heading="Start a new world?",
                              body="Everything in the game starts over: new map, new characters. "
                                   "A backup is made first and the old world is kept on the laptop.")
        combo = Gtk.DropDown.new_from_strings(["Beginner settings  ★ recommended", "Normal settings",
                                               "Hard settings", "Keep my current gameplay settings"])
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.append(Gtk.Label(label="Gameplay settings for the new world:", xalign=0))
        box.append(combo)
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("go", "Start new world")
        dlg.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r != "go":
                return
            args = ["new-world", "--yes"]
            i = combo.get_selected()
            if i < 3:
                args += ["--preset", ["beginner", "normal", "hard"][i]]
            self.app.run_task("Starting a new world", args)
        dlg.connect("response", resp)
        dlg.present(self.app.win)


