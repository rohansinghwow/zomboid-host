    def __init__(self, app):
        super().__init__()
        self.app = app
        self._busy = False
        page = Adw.PreferencesPage()
        self.set_child(page)

        self.sg = Adw.PreferencesGroup(title="Server settings")
        self.join_pw = Adw.PasswordEntryRow(title="New join password for friends", show_apply_button=True)
        self.join_pw.connect("apply", lambda *_: self.set_join_pw())
        self.sg.add(self.join_pw)
        self.mem = string_combo("Server memory", MEMORY, "More = smoother with many zombies. Leave 6 GB for the game "
                                                         "if you also play on this laptop.")
        self.mem.connect("notify::selected", lambda *_: self._changed(
            "memory", MEMORY[self.mem.get_selected()], "Server memory"))
        self.sg.add(self.mem)
        self.save_min = string_combo("Auto-save the world every", [f"{m} minutes" for m in AUTOSAVE])
        self.save_min.connect("notify::selected", lambda *_: self._changed(
            "autosave", str(AUTOSAVE[self.save_min.get_selected()]), "Auto-save"))
        self.sg.add(self.save_min)
        self.boot = Adw.SwitchRow(title="Start the server when the laptop turns on")
        self.boot.connect("notify::active", lambda *_: self._changed(
            "autostart", "yes" if self.boot.get_active() else "no", "Start on boot"))
        self.sg.add(self.boot)
        self.version = Adw.EntryRow(title="Game version (all friends must match)", show_apply_button=True)
        self.version.connect("apply", lambda *_: self.set_version())
        self.sg.add(self.version)
        self.net = string_combo("How friends connect", ["Tailscale", "Router port forwarding"])
        self.net.connect("notify::selected", lambda *_: self._changed(
            "network", "portforward" if self.net.get_selected() == 1 else "tailscale", "Connection"))
        self.sg.add(self.net)
        page.add(self.sg)

        h = Adw.PreferencesGroup(title="Check and fix")
        self._action(h, "Ping check", "Ping, Wi-Fi quality, Tailscale direct vs relay", "Check",
                     lambda: app.run_task("Ping check", ["ping"]))
        self._action(h, "Network check", "Does Jio allow port forwarding?", "Check",
                     lambda: app.run_task("Network check", ["netcheck"]))
        self._action(h, "Server log", "The last messages from the game server", "Show", self.show_log)
        self._action(h, "Check for a game server update",
                     "Never automatic. GOG players: only update when your GOG game has the same new version",
                     "Check", self.check_update)
        self._action(h, "Repair", "Fixes only what is missing or wrong. Keeps your world, settings and the "
                                  "downloaded server — the server keeps running if nothing needs a restart",
                     "Repair…", self.repair)
        self._action(h, "Send error report", "Sends the logs (passwords removed) so the problem can be fixed",
                     "Send…", app.send_report)
        self._action(h, "Update this app", "Gets the newest version from GitHub", "Update", app.update_app)
        page.add(h)

        d = Adw.PreferencesGroup(title="Danger zone")
        self._action(d, "Uninstall", "Removes services, power and network changes. The world is kept.",
                     "Uninstall…", self.uninstall, "destructive-action")
        page.add(d)

        self.about = Adw.PreferencesGroup()
        self.about_row = Adw.ActionRow(title="Zomboid Host", subtitle="")
        self.about.add(self.about_row)
        page.add(self.about)

    def _action(self, group, title, sub, label, cb, style=None):
        r = Adw.ActionRow(title=title, subtitle=sub)
        r.add_suffix(row_button(label, cb, style))
        group.add(r)

    def update(self, s):
        self._busy = True
        self.sg.set_sensitive(s.get("installed") == "yes")
        if s.get("memory") in MEMORY:
            self.mem.set_selected(MEMORY.index(s["memory"]))
        try:
            a = int(s.get("autosave") or 10)
            self.save_min.set_selected(min(range(len(AUTOSAVE)), key=lambda i: abs(AUTOSAVE[i] - a)))
        except ValueError:
            pass
        self.boot.set_active(s.get("autostart") == "yes")
        if not self.version.get_text():
            self.version.set_text(s.get("branch", ""))
        self.net.set_selected(1 if s.get("network") == "portforward" else 0)
        self.about_row.set_subtitle(f"Version {s.get('app_version', '?')} · github.com/rohansinghwow/zomboid-host")
        self._busy = False

    def _changed(self, key, value, title):
        if self._busy:
            return
        cur = {"memory": "memory", "autosave": "autosave", "autostart": "autostart", "network": "network"}[key]
        if self.app.status.get(cur) == value:
            return
        msg = ("The server restarts to use it." if self.app.status.get("running") == "yes"
               and key in ("memory", "autosave") else "")
        self.app.with_permission(lambda: self.app.run_task(f"{title}: {value}", ["set", key, value],
                                                           on_done=lambda *_: self.app.refresh_status()))
        if msg:
            self.app.win.toast(msg)

    def set_join_pw(self):
        pw = self.join_pw.get_text()
        if not PW_RE.match(pw):
            self.app.win.toast("Password: 4–32 letters, numbers, - or _")
            return
        self.join_pw.set_text("")
        self.app.confirm("Change the join password?",
                         "Friends must type the new password. The server restarts if it is running.", "Change",
                         lambda: self.app.run_task("Changing join password", ["set", "join-password"],
                                                   {"PZHOST_VALUE": pw}))

    def set_version(self):
        v = self.version.get_text().strip()
        if not v or v == self.app.status.get("branch"):
            return
        self.app.confirm(f"Switch the server to version {v}?",
                         "All friends must switch their game to the same version. This downloads the server "
                         "files again.", "Switch",
                         lambda: self.app.run_task(f"Switching to {v}", ["set", "version", v]))

    def repair(self):
        dlg = Adw.AlertDialog(heading="Repair the server setup?",
                              body="Your world, passwords, gameplay and server settings are kept. Nothing is "
                                   "downloaded again unless server files are missing.")
        chk = Gtk.CheckButton(label="Also check every server file and re-download broken ones (slow, ~5 GB check)")
        dlg.set_extra_child(chk)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("go", "Repair")
        dlg.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "go":
                env = {"PZHOST_VALIDATE": "yes"} if chk.get_active() else {}
                self.app.with_permission(lambda: self.app.run_task("Repairing", ["setup"], env))
        dlg.connect("response", resp)
        dlg.present(self.app.win)

    def check_update(self):
        def done(rc, out):
            if rc == 0 and parse_kv(out).get("update") == "yes":
                running = self.app.status.get("running") == "yes"
                self.app.confirm("Steam has a newer server — update?",
                                 "GOG players: GOG often gets new versions later than Steam. Only update when "
                                 "everyone's GOG game shows the same new version in its main menu — otherwise "
                                 "nobody can join until GOG catches up. "
                                 + ("The server stops, updates and starts again (a few minutes)." if running else ""),
                                 "Update anyway", lambda: self.app.run_task("Updating the game server", ["update-server"]),
                                 destructive=True)
        self.app.run_task("Checking for a game server update", ["update-server", "--check"], on_done=done)

    def show_log(self):
        def done(rc, out):
            dlg = Adw.Dialog(title="Server log", content_width=860, content_height=600)
            tv = Adw.ToolbarView()
            tv.add_top_bar(Adw.HeaderBar())
            view = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                left_margin=8, right_margin=8, top_margin=8)
            view.get_buffer().set_text(ANSI.sub("", out) or "(empty)")
            sw = Gtk.ScrolledWindow(child=view, vexpand=True)
            tv.set_content(sw)
            dlg.set_child(tv)
            dlg.present(self.app.win)
            GLib.idle_add(lambda: (sw.get_vadjustment().set_value(sw.get_vadjustment().get_upper()), False)[1])
        self.app.with_sudo(lambda: self.app.query(["gui-log", "400"], done))

    def uninstall(self):
        dlg = Adw.AlertDialog(heading="Uninstall the server?",
                              body="Removes the services, power, battery, Wi-Fi and firewall changes. "
                                   "Your world is kept unless you tick the box.")
        chk = Gtk.CheckButton(label="Also DELETE the server files and the world (a copy is saved to your home folder)")
        dlg.set_extra_child(chk)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("go", "Uninstall")
        dlg.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")

        def resp(_d, r):
            if r == "go":
                args = ["uninstall", "--yes"] + (["--delete-world"] if chk.get_active() else [])
                self.app.with_sudo(lambda: self.app.run_task("Uninstalling", args))
        dlg.connect("response", resp)
        dlg.present(self.app.win)


# =============================================================================
#  Application
# =============================================================================
class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.pw = None
        self.status = {}
        self.win = None
        self._status_running = False
        self._grant = False

    def do_activate(self):
        if self.win:
            self.win.present()
            return
        self.win = Window(self)
        self.win.present()
        self.refresh_status()
        GLib.timeout_add_seconds(5, self._tick)
        self.query(["update-check"], lambda rc, out: self.win.banner.set_revealed(
            parse_kv(out).get("update") == "yes"))

    # ---- environment / processes
    def env(self, extra=None):
        e = dict(os.environ)
        e["PZHOST_GUI"] = "1"
        e["SUDO_ASKPASS"] = ASKPASS   # prints PZHOST_SUDO_PW for sudo -A
        if self.pw:
            e["PZHOST_SUDO_PW"] = self.pw
        if self._grant:
            e["PZHOST_GRANT"] = "yes"   # user pressed Allow on the permission dialog
        e.update(extra or {})
        return e

    def query(self, args, cb, extra_env=None, timeout=180):
        """Run pzhost in the background; cb(rc, output) on the main thread."""
        def work():
            try:
                p = subprocess.run([PZHOST, *args], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                                   env=self.env(extra_env), timeout=timeout, errors="replace")
                rc, out = p.returncode, p.stdout + p.stderr
            except (OSError, subprocess.TimeoutExpired) as e:
                rc, out = 1, str(e)
            GLib.idle_add(lambda: (cb(rc, out), False)[1])
        threading.Thread(target=work, daemon=True).start()

    def run_task(self, title, args, extra_env=None, on_done=None):
        def go():
            TaskDialog(self, title, args, extra_env, on_done).start(self.win)
        self.with_sudo(go)

    # ---- status polling
    def _tick(self):
        self.refresh_status()
        return True

    def refresh_status(self):
        if self._status_running:
            return
        self._status_running = True

        def done(rc, out):
            self._status_running = False
            if rc != 0 and not out:
                return
            s = parse_kv(out)
            if not s:
                return
            self.status = s
            busy = s.get("busy", "")
            self.win.busy.set_title(f"Working on: {busy} — other buttons wait until it's finished" if busy else "")
            self.win.busy.set_revealed(bool(busy))
            installed = s.get("installed") == "yes"
            self.win.set_installed(installed)
            self.win.home.update(s)
            if not installed:
                self.win.setup_page.update(s)
            self.win.laptop.update(s)
            self.win.more.update(s)
        self.query(["gui-status"], done, timeout=30)

    # ---- password + permission
    def with_sudo(self, cb):
        if self.pw is not None:
            cb()
            return
        dlg = Adw.AlertDialog(heading="Laptop password",
                              body="Managing the server needs your laptop login password (the one you use for sudo). "
                                   "It is only kept while this window is open.")
        entry = Gtk.PasswordEntry(show_peek_icon=True)
        state = {"checking": False}
        err = Gtk.Label(css_classes=["error"], visible=False, wrap=True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.append(entry)
        box.append(err)
        dlg.set_extra_child(box)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("ok", "Unlock")
        dlg.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response("ok")
        dlg.set_close_response("cancel")

        def check(pw):
            try:
                p = subprocess.run(["sudo", "-S", "-k", "-p", "", "-v"], input=pw + "\n", capture_output=True,
                                   text=True, timeout=20)
                ok, msg = p.returncode == 0, p.stderr.strip()
            except (OSError, subprocess.TimeoutExpired) as e:
                ok, msg = False, str(e)
            GLib.idle_add(lambda: (checked(pw, ok, msg), False)[1])

        def checked(pw, ok, msg):
            state["checking"] = False
            if ok:
                self.pw = pw
                dlg.force_close()
                cb()
                return
            if "sudoers" in msg or "not allowed" in msg:
                err.set_label("Your user can't use sudo yet. In a terminal run:  su -   then:  "
                              f"usermod -aG sudo {os.environ.get('USER', 'youruser')}   then log out and back in.")
            else:
                err.set_label("Wrong password — try again")
            err.set_visible(True)
            entry.set_text("")
            entry.grab_focus()

        def resp(_d, r):
            if r == "ok" and not state["checking"]:
                state["checking"] = True
                err.set_label("Checking…")
                err.set_visible(True)
                threading.Thread(target=check, args=(entry.get_text(),), daemon=True).start()

        # Keep the dialog open while the password is checked; Cancel / Esc close it.
        dlg.connect("response", resp)
        dlg.set_can_close(False)
        dlg.connect("close-attempt", lambda *_: None if state["checking"] else dlg.force_close())
        entry.connect("activate", lambda *_: resp(dlg, "ok"))
        dlg.present(self.win)
        GLib.idle_add(lambda: (entry.grab_focus(), False)[1])

    def with_permission(self, cb):
        if self.status.get("permission") == "yes":
            self.with_sudo(cb)
            return

        def show(rc, text):
            dlg = Adw.AlertDialog(heading="Permission needed",
                                  body="To host the server, the app makes these changes to this laptop:")
            view = Gtk.TextView(editable=False, monospace=True, wrap_mode=Gtk.WrapMode.WORD_CHAR,
                                left_margin=6, right_margin=6)
            body = "\n".join(l for l in ANSI.sub("", text).splitlines() if "═" not in l and "Permission needed" not in l)
            view.get_buffer().set_text(body.strip())
            sw = Gtk.ScrolledWindow(child=view, min_content_height=320, min_content_width=560)
            dlg.set_extra_child(sw)
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("ok", "Allow")
            dlg.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
            dlg.set_close_response("cancel")

            def resp(_d, r):
                if r == "ok":
                    self.status["permission"] = "yes"
                    self._grant = True
                    self.with_sudo(cb)
            dlg.connect("response", resp)
            dlg.present(self.win)
        self.query(["permission-text"], show)

    # ---- helpers
    def confirm(self, heading, body, action, cb, destructive=False):
        dlg = Adw.AlertDialog(heading=heading, body=body)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("ok", action)
        dlg.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE if destructive
                                    else Adw.ResponseAppearance.SUGGESTED)
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: cb() if r == "ok" else None)
        dlg.present(self.win)

    def copy(self, text):
        Gdk.Display.get_default().get_clipboard().set_content(Gdk.ContentProvider.new_for_value(text))

    def open_url(self, url):
        Gtk.UriLauncher.new(url).launch(self.win, None, None, None)

    def send_report(self):
        dlg = Adw.AlertDialog(heading="Send an error report",
                              body="The logs are sent as a PUBLIC GitHub issue. Passwords, emails and your public IP "
                                   "are removed automatically.")
        entry = Gtk.Entry(placeholder_text="What were you doing / what went wrong?")
        dlg.set_extra_child(entry)
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("ok", "Send")
        dlg.set_response_appearance("ok", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "ok" and self.run_task(
            "Sending error report", ["report"], {"PZHOST_REPORT_DESC": entry.get_text() or "(sent from the app)"}))
        dlg.present(self.win)

    def update_app(self):
        def done(rc, out):
            if rc == 0:
                self.win.banner.set_revealed(False)
                self.confirm("App updated", "Restart the app to use the new version?", "Restart",
                             lambda: os.execv(sys.executable, [sys.executable, "/usr/local/bin/pzhost-gui"]))
        self.run_task("Updating the app", ["self-update"], on_done=done)


if __name__ == "__main__":
    sys.exit(App().run([sys.argv[0]]))
