        self.stack.add_titled_with_icon(self.setup_page, "setup", "Set up", "emblem-system-symbolic")
        self.stack.add_titled_with_icon(self.home, "home", "Server", "network-server-symbolic")
        self.stack.add_titled_with_icon(self.gameplay, "gameplay", "Gameplay", "applications-games-symbolic")
        self.stack.add_titled_with_icon(self.world, "world", "World", "folder-saved-search-symbolic")
        self.stack.add_titled_with_icon(self.console, "console", "Console", "utilities-terminal-symbolic")
