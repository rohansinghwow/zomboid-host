    def _page_changed(self, *_):
        page = self.stack.get_visible_child()
        if hasattr(page, "on_shown"):
            page.on_shown()

    def set_installed(self, installed):
        for name in ("home", "gameplay", "world", "console", "laptop"):
            self.stack.get_page(self.stack.get_child_by_name(name)).set_visible(installed)
        self.stack.get_page(self.setup_page).set_visible(not installed)
        cur = self.stack.get_visible_child_name()
        if installed and cur == "setup":
            self.stack.set_visible_child_name("home")
        elif not installed and cur in ("home", "gameplay", "world", "console", "laptop"):
            self.stack.set_visible_child_name("setup")

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=4))


