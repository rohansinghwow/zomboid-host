        g = Adw.PreferencesGroup(title="Status")
        self.r_charger = self._row(g, "Charger")
        self.r_limit = self._row(g, "Battery charge limit")
        self.r_sleep = self._row(g, "Sleep / hibernate / lid-close")
        self.r_wifi = self._row(g, "Wi-Fi")
        self.r_wd = self._row(g, "Wi-Fi watchdog")
        self.r_boot = self._row(g, "Server starts on boot")
        page.add(g)

        b = Adw.PreferencesGroup(title="Battery")
        self.limit = string_combo("Stop charging at", [x[0] for x in BATTERY],
                                  "A battery kept at 100% all day wears out fast")
        self.limit.connect("notify::selected", lambda *_: self.limit_changed())
        b.add(self.limit)
        page.add(b)

        t = Adw.PreferencesGroup(title="Tip")
        t.add(Adw.ActionRow(title="Turn the laptop back on after a power cut",
                            subtitle="In the BIOS (F2 / F10 / Del at power-on) set “AC power recovery” or "
                                     "“Power on AC attach” to ON, if your laptop has it.", subtitle_lines=3))
        page.add(t)

    def _row(self, g, title):
        r = Adw.ActionRow(title=title, subtitle="…")
        r.icon = Gtk.Image(icon_name="emblem-ok-symbolic")
        r.add_prefix(r.icon)
        g.add(r)
        return r

    @staticmethod
    def _mark(row, good, text):
        row.set_subtitle(text)
        row.icon.set_from_icon_name("emblem-ok-symbolic" if good else "dialog-warning-symbolic")
        for c in ("success", "warning"):
            row.icon.remove_css_class(c)
        row.icon.add_css_class("success" if good else "warning")

    def update(self, s):
        if s.get("battery"):
            ac = s.get("ac") == "yes"
            self._mark(self.r_charger, ac, f"{'Plugged in' if ac else 'NOT plugged in'} · battery {s['battery']}%")
            lim = s.get("limit_now", "")
            if lim == "unsupported":
                self._mark(self.r_limit, False, "This laptop only allows it in the BIOS (look for "
                                                "“Battery Health” / “Charge limit”)")
            elif lim in ("100", ""):
                self._mark(self.r_limit, False, "Off — charges to 100%")
            elif lim == "conservation":
                self._mark(self.r_limit, True, "On (Lenovo conservation mode)")
            else:
                self._mark(self.r_limit, True, f"Stops charging at {lim}%")
        else:
            self._mark(self.r_charger, True, "No battery (desktop PC)")
            self._mark(self.r_limit, True, "Not needed")
        self._mark(self.r_sleep, s.get("nosleep") == "yes",
                   "Blocked — the laptop never sleeps" if s.get("nosleep") == "yes" else "Laptop can still go to sleep")
        w = s.get("wifi", "")
        if w == "cable":
            self._mark(self.r_wifi, True, "Using a cable — best for ping")
        elif w == "offline":
            self._mark(self.r_wifi, False, "No internet connection!")
        else:
            ok = s.get("wifi_boot") == "yes" and s.get("wifi_powersave") == "off"
            sig = f" · signal {s['wifi_signal']}%" if s.get("wifi_signal") else ""
            self._mark(self.r_wifi, ok, f"{w}{sig} — " + ("connects at boot, never sleeps" if ok
                                                           else "press Set up to keep it always on"))
        self._mark(self.r_wd, s.get("watchdog") == "yes",
                   "On — reconnects Wi-Fi if the internet drops" if s.get("watchdog") == "yes" else "Off")
        self._mark(self.r_boot, s.get("autostart") == "yes",
                   "Yes" if s.get("autostart") == "yes" else "No — after a reboot someone must press Start")
        self._busy = True
        try:
            want = int(s.get("limit_setting") or 80)
            self.limit.set_selected(min(range(len(BATTERY)), key=lambda i: abs(BATTERY[i][1] - want)))
        except ValueError:
            pass
        self._busy = False

    def limit_changed(self):
        if self._busy:
            return
        pct = BATTERY[self.limit.get_selected()][1]
        if str(pct) == self.app.status.get("limit_setting"):
            return
        self.app.with_permission(lambda: self.app.run_task(f"Battery limit {pct}%", ["laptop-limit", str(pct)]))

    def on_shown(self):
        self.app.refresh_status()


