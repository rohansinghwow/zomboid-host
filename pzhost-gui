        group.add(r)

    def quick(self, key, targets=None):
        title, _sub, make_on, make_off, seconds = QUICK[key]
        targets = targets or self.targets()
        if not targets:
            self.app.win.toast("Tick at least one player first (⟳ to load who is online)")
            return
        who = ", ".join(targets)
        self.run([c for u in targets for c in make_on(u)], f"{title} → {who}")
        if make_off and seconds:
            def off():
                self.run([c for u in targets for c in make_off(u)], f"{title} — back to normal → {who}")
                return False
            GLib.timeout_add_seconds(seconds, off)
            self.app.win.toast(f"Turns itself off in {seconds} seconds")

    def _cmd(self, group, title, sub, label, cmds, confirm=False):
        r = Adw.ActionRow(title=title)
        if sub:
            r.set_subtitle(sub)
        r.add_suffix(row_button(label, lambda: self.run(cmds, title, confirm)))
        group.add(r)

    # ---- player manager
    def targets(self):
        """Names the player commands go to right now."""
        if self.everyone.get_active():
            return list(self.names)
        return [n for n, (_r, chk) in self.player_rows.items() if chk.get_active()]

    def _targets_changed(self):
        t = self.targets()
        if t:
            self.target_row.set_title("<b>Commands go to:</b> " + GLib.markup_escape_text(", ".join(t)))
        else:
            self.target_row.set_title("<b>Commands go to:</b> nobody yet — tick a player")
        everyone = self.everyone.get_active()
        for _n, (_r, chk) in self.player_rows.items():
            chk.set_sensitive(not everyone)

    def _player_row(self, name, checked, online):
        r = Adw.ActionRow(title=GLib.markup_escape_text(name),
                          subtitle="online" if online else "not online right now (added by hand)")
        chk = Gtk.CheckButton(active=checked, valign=Gtk.Align.CENTER)
        chk.connect("toggled", lambda *_: self._targets_changed())
        r.add_prefix(chk)
        r.set_activatable_widget(chk)
        menu = Gtk.MenuButton(icon_name="view-more-symbolic", valign=Gtk.Align.CENTER,
                              tooltip_text=f"Quick help for {name}")
        menu.add_css_class("flat")
        pop = Gtk.Popover()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=6, margin_bottom=6,
                      margin_start=6, margin_end=6)
        head = Gtk.Label(label=f"Only for {name}", xalign=0, margin_bottom=4)
        head.add_css_class("heading")
        box.append(head)

        def item(label, cb):
            b = Gtk.Button(label=label)
            b.add_css_class("flat")
            b.get_child().set_xalign(0)
            b.connect("clicked", lambda *_: (pop.popdown(), cb()))
            box.append(b)
        for key, (title, *_rest) in QUICK.items():
            item(title, lambda k=key: self.quick(k, [name]))
        item("Bring the ticked players here", lambda: self.teleport_to(name))
        item("Kick", lambda: self.run([f'kickuser {q(name)} -r "Kicked by host"'], f"Kick → {name}", True))
        pop.set_child(box)
        menu.set_popover(pop)
        r.add_suffix(menu)
        return r, chk

    def _rebuild_players(self, checked):
        for _n, (r, _c) in self.player_rows.items():
            self.pm.remove(r)
        self.pm.remove(self.player_typed)
        self.player_rows = {}
        for n in self.names + [e for e in self.extra if e not in self.names]:
            row, chk = self._player_row(n, n in checked, n in self.names)
            self.player_rows[n] = (row, chk)
            self.pm.add(row)
        if not self.player_rows:
            empty = Adw.ActionRow(title="Nobody online right now", subtitle="Press ⟳ when your friends are in the game")
            self.player_rows["\0empty"] = (empty, Gtk.CheckButton())
            self.pm.add(empty)
        self.pm.add(self.player_typed)
        labels = self.names or ["(nobody online)"]
        self.tp_target.set_model(Gtk.StringList.new(labels))
        self._targets_changed()

    def add_typed(self):
        name = self.player_typed.get_text().strip().replace('"', "")
        if not name:
            return
        self.player_typed.set_text("")
        if name not in self.extra and name not in self.names:
            self.extra.append(name)
        checked = set(self.targets()) | {name}
        self._rebuild_players(checked)

    def for_player(self, make, title, confirm=False):
        targets = self.targets()
        if not targets:
            self.app.win.toast("Tick at least one player first (⟳ to load who is online)")
            return
        cmds = [c for u in targets for c in make(u)]
        if not cmds:
            self.app.win.toast("Nothing to do for these players")
            return
        self.run(cmds, f"{title} → {', '.join(targets)}", confirm)

    def run(self, cmds, title, confirm=False):
        if self.app.status.get("running") != "yes":
            self.app.win.toast("Start the server first (Server tab)")
            return

        def go():
            self.log(f"▶ {title}\n" + "".join(f"  > {c}\n" for c in cmds))

            def done(rc, out):
                ans = ANSI.sub("", out).replace("── server answer ──\n", "").strip()
                self.log((ans or "(no answer from the server)") + "\n\n")
                self.app.win.toast(f"{title}: sent" if rc == 0 else f"{title}: failed")
            self.app.query(["console", *cmds], done, timeout=90)
        if confirm:
            self.app.confirm(f"{title}?", "Sends: " + " · ".join(cmds), "Do it", lambda: self.app.with_sudo(go),
                             destructive=True)
        else:
            self.app.with_sudo(go)

    def log(self, text):
        self.out.insert(self.out.get_end_iter(), text)
        self.out_view.scroll_to_mark(self.out.create_mark(None, self.out.get_end_iter(), False), 0, False, 0, 1)

    # ---- actions
    def refresh_players(self, quiet=False):
        if self.app.status.get("running") != "yes":
            if not quiet:
                self.app.win.toast("Server is stopped")
            return
        before = set(self.targets())
        first_time = not self.names

        def done(rc, out):
            names = [l.strip().lstrip("-").strip() for l in ANSI.sub("", out).splitlines()
                     if l.strip().startswith("-")]
            if rc != 0 and not names:
                return
            self.names = names
            checked = before & (set(names) | set(self.extra))
            if not checked and first_time and len(names) == 1:
                checked = {names[0]}               # only one player online → tick them
            self._rebuild_players(checked)
            if not quiet:
                self.app.win.toast(f"{len(names)} player(s) online")
        self.app.with_sudo(lambda: self.app.query(["players"], done))

    def _auto_refresh(self):
        # every 30 s while the Console tab is open (never asks for the password by itself)
        if (self.app.pw is not None and self.app.win and self.app.win.stack.get_visible_child() is self
                and self.app.status.get("running") == "yes"):
            self.refresh_players(quiet=True)
        return True

    def teleport_to(self, dest):
        self.for_player(lambda u: [] if u == dest else [f"teleportplayer {q(u)} {q(dest)}"], f"Bring to {dest}")

    def teleport(self):
        i = self.tp_target.get_selected()
        if not self.names or i >= len(self.names):
            self.app.win.toast("Refresh players first")
            return
        self.teleport_to(self.names[i])

    def give(self, title, items):
        self.for_player(lambda u: [f"additem {q(u)} {item} {n}" for item, n in items], f"Give {title}")

    def give_custom(self):
        parts = self.item.get_text().split()
        if not parts:
            return
        item = parts[0]
        n = parts[1] if len(parts) > 1 and parts[1].isdigit() else "1"
        if not re.match(r"^[A-Za-z0-9_]+\.[A-Za-z0-9_]+$", item):
            self.app.win.toast("Item IDs look like Base.Axe")
            return
        self.for_player(lambda u: [f"additem {q(u)} {item} {n}"], f"Give {item} x{n}")

    def spawn_vehicle(self):
        name, vid = VEHICLES[self.vehicle.get_selected()]
        self.for_player(lambda u: [f"addvehicle {vid} {q(u)}"], f"Spawn {name}")

    def give_xp(self):
        sk = SKILLS[self.skill.get_selected()]
        self.for_player(lambda u: [f"addxp {q(u)} {sk}=1000"], f"1000 XP {sk}")

    def give_picked(self):
        label, iid, _ = self.items[self.item_pick.get_selected()]
        n = int(self.item_count.get_value())
        self.for_player(lambda u: [f"additem {q(u)} {iid} {n}"], f"Give {n}× {label.split(' · ')[-1]}")

    def lib_changed(self):
        c, t, tpl, desc, danger = COMMANDS[self.lib.get_selected()]
        self.lib_info.set_title(tpl)
        self.lib_info.set_subtitle(("⚠ " if danger else "") + (desc or t))

    def _fill(self, tpl, u):
        i = self.tp_target.get_selected()
        p2 = self.names[i] if self.names and i < len(self.names) else "OTHERPLAYER"
        return tpl.replace("{p2}", q(p2)).replace("{p}", q(u))

    def lib_send(self):
        _, t, tpl, _, danger = COMMANDS[self.lib.get_selected()]
        if "{p}" in tpl:
            self.for_player(lambda u: [self._fill(tpl, u)], t, confirm=danger)
        else:
            self.run([tpl], t, confirm=danger)

    def lib_use(self):
        _, t, tpl, _, _ = COMMANDS[self.lib.get_selected()]
        if "{p}" in tpl or "{p2}" in tpl:
            targets = self.targets()
            if not targets:
                self.app.win.toast("Tick a player first (⟳ to load who is online)")
                return
            tpl = self._fill(tpl, targets[0])
            if len(targets) > 1:
                self.app.win.toast(f"Filled in for {targets[0]} — use Send to run it for all {len(targets)} players")
        self.free.set_text(tpl)
        self.free.grab_focus()

    def send_free(self):
        cmd = self.free.get_text().strip().lstrip("/")
        if not cmd:
            return
        self.free.set_text("")
        self.run([cmd], cmd, confirm=cmd.split()[0].lower() in DANGEROUS)

    def on_shown(self):
        if self.app.status.get("running") == "yes":
            self.refresh_players(quiet=bool(self.names))
        if not getattr(self, "_auto_on", False):
            self._auto_on = True
            GLib.timeout_add_seconds(30, self._auto_refresh)


