    def _copy_row(self, group, title, secret=False):
        row = Adw.ActionRow(title=title, subtitle="…")
        row.add_css_class("property")
        row.secret = secret
        row.value = ""
        if secret:
            eye = Gtk.ToggleButton(icon_name="view-reveal-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Show")
            eye.add_css_class("flat")
            eye.connect("toggled", lambda b: row.set_subtitle(row.value if b.get_active() else "••••••••"))
            row.add_suffix(eye)
            row.eye = eye
        cp = Gtk.Button(icon_name="edit-copy-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Copy")
        cp.add_css_class("flat")
        cp.connect("clicked", lambda *_: (self.app.copy(row.value), self.app.win.toast(f"{title} copied")))
        row.add_suffix(cp)
        group.add(row)
        return row

    def _set(self, row, value):
        row.value = value
        if row.secret and not row.eye.get_active():
            row.set_subtitle("••••••••" if value else "-")
        else:
            row.set_subtitle(value or "-")

    def update(self, s):
        running = s.get("running") == "yes"
        self.state_row.set_title("Running" if running else "Stopped")
        self.state_row.set_subtitle(("since " + s.get("since", "")) if running and s.get("since") else
                                    "Friends can't join until you press Start" if not running else "")
        for c in ("success", "error"):
            self.state_icon.remove_css_class(c)
        self.state_icon.add_css_class("success" if running else "error")
        self.btn_start.set_visible(not running)
        self.btn_stop.set_visible(running)
        self.btn_restart.set_visible(running)
        ip = s.get("ip") or ("Tailscale not connected — More → Repair" if s.get("network") == "tailscale"
                             else "could not detect")
        self._set(self.addr, ip)
        self._set(self.port, s.get("port", "16261"))
        self._set(self.pw, s.get("join_password", ""))
        self.ver.set_subtitle(s.get("branch", "") + " — friends must use exactly this version")
        if s.get("network") == "tailscale":
            self.net_row.set_subtitle("Tailscale — friends install Tailscale, accept your invite and stay connected")
        else:
            self.net_row.set_subtitle("Port forwarding — the IP can change after a router restart")

    def copy_card(self):
        def done(rc, out):
            lines = ANSI.sub("", out).splitlines()
            start = next((i for i, l in enumerate(lines) if "JOIN INFO" in l), 0)
            end = max((i for i, l in enumerate(lines) if l.startswith("====")), default=len(lines) - 1)
            self.app.copy("\n".join(lines[start:end + 1]).strip())
            self.app.win.toast("Join info copied — paste it in your group chat")
        self.app.query(["join"], done)

    def refresh_players(self):
        if self.app.status.get("running") != "yes":
            self.players.set_title("Server is stopped")
            self.players.set_subtitle("")
            return
        self.players.set_title("Asking the server…")

        def done(rc, out):
            lines = [l.strip() for l in ANSI.sub("", out).splitlines()
                     if l.strip() and "password" not in l.lower() and "Players online" not in l]
            names = [l.lstrip("-").strip() for l in lines if l.startswith("-")]
            if names:
                self.players.set_title(f"{len(names)} online")
                self.players.set_subtitle(", ".join(names))
            else:
                self.players.set_title("Nobody online right now" if rc == 0 else "Could not ask the server")
                self.players.set_subtitle("\n".join(lines[-3:]) if rc != 0 else "")
        self.app.with_sudo(lambda: self.app.query(["players"], done))

    def say(self):
        text = self.msg.get_text().strip()
        if not text:
            return
        self.msg.set_text("")
        self.app.with_sudo(lambda: self.app.query(
            ["say", text], lambda rc, out: self.app.win.toast("Message sent" if rc == 0 else "Could not send")))

    def on_shown(self):
