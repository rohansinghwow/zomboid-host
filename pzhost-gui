def parse_kv(text):
    d = {}
    for line in text.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            d[k.strip()] = v.strip()
    return d


def closest(options, raw):
    """Index of the option whose value is closest to raw (numbers) or equal (text)."""
    if raw is None or raw == "":
        return None
    try:
        r = float(raw)
        return min(range(len(options)), key=lambda i: abs(float(options[i][1]) - r))
    except ValueError:
        for i, (_, v) in enumerate(options):
            if v == raw:
                return i
    return None


def row_button(label, cb, style=None, icon=None):
    b = Gtk.Button(valign=Gtk.Align.CENTER)
    if icon and not label:
        b.set_icon_name(icon)
    else:
        b.set_label(label)
    if style:
        b.add_css_class(style)
    b.connect("clicked", lambda *_: cb())
    return b


def string_combo(title, labels, subtitle=None):
    row = Adw.ComboRow(title=title, model=Gtk.StringList.new(labels))
    if subtitle:
        row.set_subtitle(subtitle)
    return row


# =============================================================================
#  Task dialog: runs one pzhost command and shows its output live
# =============================================================================
class TaskDialog(Adw.Dialog):
    def __init__(self, app, title, args, extra_env=None, on_done=None):
        super().__init__(title=title, content_width=720, content_height=520)
        self.app, self.args, self.on_done = app, args, on_done
        self.extra_env = extra_env or {}
        self.opened_urls = set()
        self.proc = None

        tv = Adw.ToolbarView()
        hb = Adw.HeaderBar()
        tv.add_top_bar(hb)

        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10,
                      margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        top = Gtk.Box(spacing=10)
        self.spinner = Adw.Spinner() if hasattr(Adw, "Spinner") else Gtk.Spinner(spinning=True)
        self.status = Gtk.Label(label="Working… please wait", xalign=0, hexpand=True, wrap=True)
        self.status.add_css_class("title-4")
        top.append(self.spinner)
        top.append(self.status)
        box.append(top)

        self.buf = Gtk.TextBuffer()
        self.view = Gtk.TextView(buffer=self.buf, editable=False, cursor_visible=False, monospace=True,
                                 wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=8, bottom_margin=8,
                                 left_margin=8, right_margin=8)
        sw = Gtk.ScrolledWindow(vexpand=True, child=self.view)
        sw.add_css_class("card")
        box.append(sw)

        self.links = Gtk.Box(spacing=8)
        box.append(self.links)

        btns = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        self.report_btn = Gtk.Button(label="Send error report", visible=False)
        self.report_btn.add_css_class("destructive-action")
        self.report_btn.connect("clicked", lambda *_: (self.close(), self.app.send_report()))
        self.close_btn = Gtk.Button(label="Close", sensitive=False)
        self.close_btn.add_css_class("suggested-action")
        self.close_btn.connect("clicked", lambda *_: self.close())
        btns.append(self.report_btn)
        btns.append(self.close_btn)
        box.append(btns)

        tv.set_content(box)
        self.set_child(tv)
        self.set_can_close(False)

    def start(self, parent):
        self.present(parent)
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        try:
            self.proc = subprocess.Popen([PZHOST, *self.args], stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                         stderr=subprocess.STDOUT, env=self.app.env(self.extra_env),
                                         text=True, bufsize=1, errors="replace")
            for line in self.proc.stdout:
                GLib.idle_add(self._append, ANSI.sub("", line))
            rc = self.proc.wait()
        except OSError as e:
            GLib.idle_add(self._append, f"Could not run pzhost: {e}\n")
            rc = 127
        GLib.idle_add(self._finish, rc)

    def _append(self, line):
        end = self.buf.get_end_iter()
        self.buf.insert(end, line)
        self.view.scroll_to_mark(self.buf.create_mark(None, self.buf.get_end_iter(), False), 0, False, 0, 1)
        for rx, label in ((URL_TAILSCALE, "Open Tailscale login"), (URL_GH, "Open GitHub login"),
                          (URL_ISSUE, "Open the report")):
            m = rx.search(line)
            if m and m.group(0) not in self.opened_urls:
                url = m.group(0).rstrip(".,)")
                self.opened_urls.add(m.group(0))
                b = Gtk.Button(label=label)
                b.add_css_class("pill")
                b.connect("clicked", lambda *_, u=url: self.app.open_url(u))
                self.links.append(b)
                if rx is URL_TAILSCALE:
                    self.status.set_label("Log in to Tailscale in your browser (it opened by itself) — then wait here")
                    self.app.open_url(url)
        m = GH_CODE.search(line)
        if m:
            code = m.group(1)
            self.app.copy(code)
            self.status.set_label(f"GitHub code {code} copied — paste it in the browser page")
        return False

    def _finish(self, rc):
        self.spinner.set_visible(False)
        self.close_btn.set_sensitive(True)
        self.set_can_close(True)
        if rc == 0:
            self.status.set_label("✔ Done")
        else:
            self.status.set_label("✘ Something went wrong — see the messages above")
            if self.args[:1] != ["report"]:
                self.report_btn.set_visible(True)
        if self.on_done:
            self.on_done(rc, self.buf.get_text(self.buf.get_start_iter(), self.buf.get_end_iter(), False))
        self.app.refresh_status()
        return False


