class SetupPage(Adw.Bin):
    def __init__(self, app):
        super().__init__()
        self.app = app
        page = Adw.PreferencesPage()
        self.set_child(page)

        intro = Adw.PreferencesGroup(
            title="Set up your Project Zomboid server",
            description="Fill this in once. The app downloads the server (~5 GB), creates the world and "
                        "sets the laptop up as a server. It takes 10–30 minutes.")
        page.add(intro)

        g = Adw.PreferencesGroup(title="Game")
        self.version = Adw.EntryRow(title="Game version (must match all friends' game)", text="42.21")
        self.playing = Adw.SwitchRow(title="I will also play the game on this laptop",
                                     subtitle="Leaves more memory for the game", active=True)
        g.add(self.version)
        g.add(self.playing)
        page.add(g)

        p = Adw.PreferencesGroup(title="Passwords",
                                 description="4–32 characters: letters, numbers, - or _")
        self.join_pw = Adw.PasswordEntryRow(title="Join password (friends type this to join)")
        self.admin_pw = Adw.PasswordEntryRow(title="Admin password (only for you — different from join password)")
        p.add(self.join_pw)
        p.add(self.admin_pw)
        page.add(p)

        n = Adw.PreferencesGroup(title="Connection")
        self.net = string_combo("How friends connect", ["Tailscale  ★ recommended (works with Jio)",
                                                        "Router port forwarding"])
        self.autostart = Adw.SwitchRow(title="Start the server when the laptop turns on", active=True)
        n.add(self.net)
        n.add(self.autostart)
        page.add(n)

        b = Adw.PreferencesGroup()
        go = Gtk.Button(label="Set up the server", halign=Gtk.Align.CENTER, margin_top=6)
        go.add_css_class("suggested-action")
        go.add_css_class("pill")
        go.connect("clicked", lambda *_: self.start())
        b.add(go)
        page.add(b)

    def update(self, s):
        """Fill the form with the settings that already exist (e.g. after an uninstall or a failed setup)."""
        if getattr(self, "_filled", False):
            return
        self._filled = True
        if s.get("branch"):
            self.version.set_text(s["branch"])
        self.net.set_selected(1 if s.get("network") == "portforward" else 0)
        if s.get("autostart"):
            self.autostart.set_active(s["autostart"] == "yes")
        if s.get("join_password"):
            self.join_pw.set_title("Join password — leave empty to keep the current one")
        if s.get("admin_set") == "yes":
            self.admin_pw.set_title("Admin password — already set, leave empty to keep it")

    def start(self):
        jp, ap = self.join_pw.get_text(), self.admin_pw.get_text()
        have_jp = bool(self.app.status.get("join_password"))
        have_ap = self.app.status.get("admin_set") == "yes"
        if (jp or not have_jp) and not PW_RE.match(jp) or (ap or not have_ap) and not PW_RE.match(ap):
            self.app.win.toast("Passwords: 4–32 letters, numbers, - or _")
            return
        if jp and jp == ap:
            self.app.win.toast("Use a different admin password")
            return
        ram = int(self.app.status.get("ram_gb") or 16)
        if self.playing.get_active():
            xmx = "6g" if ram >= 15 else "3g"
        else:
            xmx = "8g" if ram >= 15 else "4g"
        env = {"GUI_BRANCH": self.version.get_text().strip() or "42.21", "GUI_XMX": xmx,
               "GUI_JOIN_PASSWORD": jp, "GUI_ADMIN_PASSWORD": ap,
               "GUI_NETWORK": "portforward" if self.net.get_selected() == 1 else "tailscale",
               "GUI_AUTOSTART": "yes" if self.autostart.get_active() else "no"}
        self.app.with_permission(lambda: self.app.run_task("Setting up the server", ["setup"], env))


