class GameplayPage(Adw.Bin):
    def __init__(self, app):
        super().__init__()
        self.app = app
        self.loaded = False
        page = Adw.PreferencesPage()
        self.set_child(page)

        pg = Adw.PreferencesGroup(title="Quick presets",
                                  description="New to Project Zomboid? Start with Beginner. You can change single options below after.")
        for key, title, desc in PRESETS:
            r = Adw.ActionRow(title=title, subtitle=desc, subtitle_lines=3)
            b = row_button("Use", lambda k=key, t=title: self.preset(k, t),
                           "suggested-action" if key == "beginner" else None)
            r.add_suffix(b)
            r.set_activatable_widget(b)
            pg.add(r)
        page.add(pg)

        og = Adw.PreferencesGroup(title="Change one thing")
        self.status_lbl = Gtk.Label(label="", css_classes=["dim-label"])
        og.set_header_suffix(self.status_lbl)
        self.rows = {}
        for key, title, sub, opts in GAMEPLAY:
            r = string_combo(title, [o[0] for o in opts], sub)
            r.set_sensitive(False)
            self.rows[key] = r
            og.add(r)
        page.add(og)

        sg = Adw.PreferencesGroup()
        save = Gtk.Button(label="Save and apply", halign=Gtk.Align.CENTER)
        save.add_css_class("suggested-action")
        save.add_css_class("pill")
        save.connect("clicked", lambda *_: self.save())
        sg.add(save)
        page.add(sg)

    def on_shown(self):
        if not self.loaded:
            self.load()

    def load(self):
        self.status_lbl.set_label("Loading…")

        def done(rc, out):
            if rc != 0:
                self.status_lbl.set_label("Could not read settings")
                self.app.win.toast(ANSI.sub("", out).strip().splitlines()[-1] if out.strip() else "Could not read settings")
                return
            vals = parse_kv(out)
            self.current = {}
            for key, _, _, opts in GAMEPLAY:
                row = self.rows[key]
                i = closest(opts, vals.get(key))
                if i is None:
                    row.set_sensitive(False)
                    row.set_subtitle("Not available in this game version")
                    continue
                row.set_sensitive(True)
                row.set_selected(i)
                self.current[key] = i
            self.loaded = True
            self.status_lbl.set_label("")
        self.app.with_sudo(lambda: self.app.query(["gameplay-get"], done))

    def _restart_note(self):
        return ("The server restarts to use the new settings (friends are kicked for about a minute)."
                if self.app.status.get("running") == "yes" else "They are used the next time the server starts.")

    def preset(self, key, title):
        self.app.confirm(f"Use the {title} settings?", self._restart_note(), "Apply",
                         lambda: self.app.run_task(f"Applying {title} settings", ["gameplay-set", f"preset={key}"],
                                                   on_done=lambda rc, out: self.load()))

    def save(self):
        if not self.loaded:
            return self.load()
        changes = []
        for key, _, _, opts in GAMEPLAY:
            row = self.rows[key]
            if key in self.current and self.current[key] != row.get_selected():
                changes.append(f"{key}={opts[row.get_selected()][1]}")
        if not changes:
            self.app.win.toast("Nothing changed")
            return
        self.app.confirm("Save gameplay settings?", self._restart_note(), "Save",
                         lambda: self.app.run_task("Saving gameplay settings", ["gameplay-set", *changes],
                                                   on_done=lambda rc, out: self.load()))


