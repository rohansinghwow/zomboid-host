  fi
  echo "limit_setting=${BATTERY_LIMIT}"
  if [[ $(systemctl is-enabled sleep.target 2>/dev/null) == masked ]]; then echo "nosleep=yes"; else echo "nosleep=no"; fi
  if systemctl is-enabled -q pzwifi-watchdog.timer 2>/dev/null; then echo "watchdog=yes"; else echo "watchdog=no"; fi
  wifi_status_kv
  return 0
}

cmd_set() {  # pzhost set KEY VALUE  (join-password reads PZHOST_VALUE so it never shows in ps)
  require_installed || return 1; ensure_permission || return 1
  local k=${1:-} v=${2:-${PZHOST_VALUE:-}}
  case $k in
    join-password)
      [[ $v =~ ^[A-Za-z0-9_-]{4,32}$ ]] || { err "Password: 4-32 letters, digits, - or _"; return 1; }
      JOIN_PASSWORD=$v; save_config; configure_ini && ok "Join password changed."; apply_change_restart ;;
    memory)
      [[ $v =~ ^[0-9]+[gm]$ ]] || { err "Memory like 6g"; return 1; }
      XMX=$v; save_config; set_xmx && ok "Server memory ${v}."; apply_change_restart ;;
    autosave)
      [[ $v =~ ^[0-9]+$ ]] && (( v >= 1 && v <= 120 )) || { err "Minutes 1-120"; return 1; }
      SAVE_MINUTES=$v; save_config; configure_ini && ok "Auto-save every ${v} min."; apply_change_restart ;;
    autostart)
      if [[ $v == yes ]]; then sudo systemctl enable pzserver.service && AUTOSTART=yes
      else sudo systemctl disable pzserver.service && AUTOSTART=no; fi
      save_config; ok "Start on boot: ${AUTOSTART}" ;;
    network)
      [[ $v =~ ^(tailscale|portforward)$ ]] || { err "tailscale or portforward"; return 1; }
      NETWORK_MODE=$v; save_config
      step "Install packages" install_packages && step "Firewall" firewall_open && step "Network" network_setup || { on_fail; return 1; } ;;
    version)
      [[ $v =~ ^[A-Za-z0-9._-]+$ ]] || { err "Bad version"; return 1; }
      PZ_BRANCH=$v; save_config; cmd_update_server ;;
    *) err "Unknown setting: $k"; return 1 ;;
  esac
}

cmd_gui_log() {  # last server log lines (GUI)
  sudo_start >/dev/null || return 1
  sudo journalctl -q -u pzserver.service -n "${1:-300}" -o cat --no-pager
}

cmd_laptop() {
  ensure_permission || return 1
  while :; do
    local lim con dev sys="${R}no${N}" wifi="-"
    lim=$(battery_limit_now) || lim=""
    [[ $(systemctl is-enabled sleep.target 2>/dev/null) == masked ]] && sys="${G}yes${N}"
    dev=$(wifi_iface)
    if [[ -n $dev ]] && command -v nmcli >/dev/null; then
      con=$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null)
      if [[ -z $(nmcli -g connection.permissions connection show "$con" 2>/dev/null) \
            && $(nmcli -g 802-11-wireless-security.psk-flags connection show "$con" 2>/dev/null) == 0* ]]; then
        wifi="${G}${con} — connects at boot, auto-reconnects${N}"
      else wifi="${Y}${con} — needs a login after reboot (choose 1)${N}"; fi
    elif [[ -z $dev ]]; then wifi="cable / Ethernet"; fi
    echo; echo "${W}── Laptop server mode ──${N}"
    if battery_present; then
      local cap; cap=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -1)
      echo "  Charger         : $(on_ac && echo "${G}plugged in${N}" || echo "${R}NOT plugged in${N}") · battery ${cap}%"
      case $lim in
        "") echo "  Charge limit    : ${Y}not supported from Linux — set it in BIOS (choose 1 for help)${N}" ;;
        100) echo "  Charge limit    : ${Y}off (charges to 100%)${N}" ;;
        conservation) echo "  Charge limit    : ${G}on (Lenovo conservation mode)${N}" ;;
        *) echo "  Charge limit    : ${G}${lim}%${N}" ;;
      esac
    fi
    echo "  No sleep / hibernate / lid-close sleep : ${sys}"
    echo "  Wi-Fi           : ${wifi}"
    echo "  Server starts on boot : $( [[ $AUTOSTART == yes ]] && echo "${G}yes${N}" || echo "${Y}no${N}")"
    cat <<EOF

   1) ${W}Make this laptop a server${N} (battery ${BATTERY_LIMIT}%, no sleep, Wi-Fi never sleeps +
      auto-reconnect, server starts on boot)
   2) Change battery limit (current setting: ${BATTERY_LIMIT}%)
   0) Back

  ${D}Tip: in the BIOS, set "AC power recovery / Power on AC attach" to ON if it exists —
  then the laptop turns itself back on after a power cut.${N}
EOF
    case $(ask "Choose" 0) in
      1) cmd_laptop_apply ;;
      2) local p; p=$(ask "Stop charging at (60, 80 recommended, or 100 = no limit)" "$BATTERY_LIMIT")
         if [[ $p =~ ^[0-9]+$ ]] && (( p >= 50 && p <= 100 )); then
           BATTERY_LIMIT=$p; save_config; step "Battery charge limit" battery_limit_apply "$p"
         else warn "Use a number from 50 to 100."; fi ;;
      *) return 0 ;;
    esac
  done
}

firewall_open() {
  if command -v ufw >/dev/null && sudo ufw status 2>/dev/null | grep -q "Status: active"; then
    run sudo ufw allow "${GAME_PORT}:${UDP_PORT}/udp" comment 'Project Zomboid' || return 1
    if [[ $NETWORK_MODE == tailscale ]]; then
      run sudo ufw allow in on tailscale0 comment 'Tailscale' || return 1
      run sudo ufw allow "${TS_PORT}/udp" comment 'Tailscale direct' || return 1
    fi
    ok "ufw: ports opened"
  elif systemctl is-active -q firewalld; then
    run sudo firewall-cmd --permanent --add-port="${GAME_PORT}-${UDP_PORT}/udp" || return 1
    [[ $NETWORK_MODE == tailscale ]] && run sudo firewall-cmd --permanent --zone=trusted --add-interface=tailscale0 \
      && run sudo firewall-cmd --permanent --add-port="${TS_PORT}/udp"
    run sudo firewall-cmd --reload || return 1
    ok "firewalld: ports opened"
  else
    ok "No active firewall — ports are already reachable"
  fi
}

wifi_iface() {  # prints the Wi-Fi interface used for internet, if any
  local dev; dev=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
  [[ -n $dev && -d /sys/class/net/$dev/wireless ]] && echo "$dev"
}

optimize_network() {
  # Bigger socket buffers + fair queueing: fewer drops/spikes for game UDP traffic.
  sudo tee "$SYSCTL_FILE" >/dev/null <<'EOF'
# pzhost: low-latency tuning for the Project Zomboid server
net.core.rmem_max = 4194304
net.core.wmem_max = 4194304
net.core.rmem_default = 1048576
net.core.wmem_default = 1048576
net.core.netdev_max_backlog = 5000
net.core.default_qdisc = fq_codel
EOF
  run sudo sysctl -q -p "$SYSCTL_FILE" || return 1
  ok "Network buffers tuned"

  # Wi-Fi power saving causes 50-300 ms ping spikes; turn it off permanently.
  if [[ -d /etc/NetworkManager ]]; then
    sudo mkdir -p "$(dirname "$NM_WIFI_CONF")"
    printf '[connection]\nwifi.powersave = 2\n' | sudo tee "$NM_WIFI_CONF" >/dev/null
    sudo systemctl reload NetworkManager 2>/dev/null || true
    ok "Wi-Fi power saving disabled (permanent)"
  fi
  local w; w=$(wifi_iface)
  if [[ -n $w ]]; then
    command -v iw >/dev/null && sudo iw dev "$w" set power_save off 2>/dev/null
    warn "You are on Wi-Fi (${w}). An Ethernet cable to the Jio router gives the most stable ping."
  else
    ok "Wired connection detected — best for ping"
  fi
  command -v powerprofilesctl >/dev/null \
    && ok "Power profile switches to 'performance' while the server runs" \
    || info "power-profiles-daemon not installed — skipping power profile tuning"
  return 0
}

ping_stats() {  # ping_stats HOST COUNT → prints "avg jitter loss" (ms ms %)
  ping -n -q -c "$2" -i 0.2 -W 2 "$1" 2>/dev/null | awk -F'[/ ,%]+' '
    /packet loss/ {for(i=1;i<=NF;i++) if($i=="packet") loss=$(i-1)}
    /rtt|round-trip/ {for(i=1;i<=NF;i++) if($i ~ /^[0-9.]+$/) v[++n]=$i}
    END {printf "%s %s %s\n", (n>=4?v[n-2]:"-"), (n>=4?v[n]:"-"), (loss==""?"100":loss)}'
}

cmd_pingcheck() {
  echo; echo "${W}── Ping check ──${N}"
  local w gw r avg jit loss
  w=$(wifi_iface); gw=$(gateway_ip)
  if [[ -n $w ]]; then
    local line; command -v nmcli >/dev/null && line=$(nmcli -t -f IN-USE,SSID,SIGNAL,FREQ dev wifi 2>/dev/null | grep '^\*' | head -1)
    local sig freq; sig=$(cut -d: -f3 <<<"$line"); freq=$(cut -d: -f4 <<<"$line" | tr -dc '0-9')
    echo "  Connection : ${Y}Wi-Fi${N} (${w}) · signal ${sig:-?}% · $( [[ ${freq:-0} -ge 4900 ]] && echo 5 GHz || echo "${Y}2.4 GHz${N}")"
    [[ ${freq:-0} -lt 4900 ]] && warn "Use the Jio router's 5 GHz network (or Ethernet) — 2.4 GHz is slower and noisier."
    [[ -n $sig && $sig -lt 60 ]] && warn "Weak signal — move the laptop closer to the router."
    local ps; ps=$(command -v iw >/dev/null && iw dev "$w" get power_save 2>/dev/null)
    [[ $ps == *on* ]] && warn "Wi-Fi power saving is ON — run Repair to turn it off."
  else
    echo "  Connection : ${G}Ethernet${N}"
  fi

  for target in "${gw:-192.168.29.1}:Router" "1.1.1.1:Internet"; do
    read -r avg jit loss < <(ping_stats "${target%%:*}" 20)
    printf '  %-10s : avg %s ms · jitter %s ms · loss %s%%\n' "${target##*:}" "$avg" "$jit" "$loss"
    if [[ ${target##*:} == Router && $jit != - ]] && awk "BEGIN{exit !($jit > 5)}"; then
      warn "High jitter to the router — Wi-Fi interference or someone downloading/streaming at home."
    fi
  done

  if [[ $NETWORK_MODE == tailscale ]] && command -v tailscale >/dev/null; then
    echo; echo "  ${W}Tailscale${N}"
    tailscale netcheck 2>/dev/null | grep -E "UDP:|MappingVariesByDestIP|Nearest DERP" | sed 's/^\s*/    /'
    echo "  ${W}Friends' connections${N} (direct = best ping, relay = slower):"
    local peers; peers=$(tailscale status 2>/dev/null | tail -n +2 | grep -v '^#' | awk 'NF')
    if [[ -z $peers ]]; then
      echo "    (no friends connected right now — check again while they are in game)"
    else
      while read -r line; do
        local name; name=$(awk '{print $2}' <<<"$line")
        if [[ $line == *direct* ]]; then echo "    ${G}●${N} ${name}: direct"
        elif [[ $line == *relay* ]]; then echo "    ${Y}●${N} ${name}: relay ($(grep -o 'relay "[^"]*"' <<<"$line"))"
        else echo "    ${D}●${N} ${name}: idle/offline"; fi
      done <<<"$peers"
      echo "    ${D}Tip: 'tailscale ping <name>' forces a direct path attempt.${N}"
    fi
  fi

  cat <<EOF

  ${W}Tips for best ping on Jio${N}
   • Ethernet cable from laptop to Jio router (biggest improvement)
   • If Wi-Fi: use the 5 GHz network, keep the laptop near the router
   • Pause big downloads / 4K streaming / game updates at home while playing
   • Friends with "relay": their router blocks direct UDP. They can try
     another network or a phone hotspot, or restart Tailscale
   • Restart the Jio router once if pings suddenly get worse
EOF
}

network_setup() {
  if [[ $NETWORK_MODE == tailscale ]]; then
    run sudo systemctl enable --now tailscaled || return 1
    sleep 2
    if tailscale_ip >/dev/null && [[ -n $(tailscale_ip) ]]; then
      ok "Tailscale connected: $(tailscale_ip)"
    else
      info "Log in to Tailscale — open the link below in your browser:"
      sudo tailscale up --operator="$USER" || return 1
    fi
    sudo tailscale set --operator="$USER" >/dev/null 2>&1 || true
    [[ -n $(tailscale_ip) ]] || { err "Tailscale has no IP — login not finished?"; return 1; }
    ok "Tailscale IP: $(tailscale_ip)"
    tailscale_share_help
  else
    cmd_netcheck
  fi
}

tailscale_share_help() {
  cat <<EOF

${W}Share this laptop with your 4 friends (one time):${N}
  1. Open ${C}https://login.tailscale.com/admin/machines${N}
  2. Find "${W}$(hostname)${N}" → click ⋯ → ${W}Share…${N}
  3. Enter each friend's email → Send invite
  4. Each friend installs Tailscale (${C}https://tailscale.com/download${N}),
     signs in with that email and accepts the invite.
EOF
}

cmd_setup() {
  ensure_permission || return 1
  local fresh=no
  [[ -z $JOIN_PASSWORD || -z $ADMIN_PASSWORD || $INSTALLED != yes ]] && fresh=yes
  if [[ ${PZHOST_GUI:-} == 1 ]]; then
    setup_from_gui || return 1
  elif [[ $fresh == yes ]] || ask_yn "Review the setup answers (version, RAM, passwords, network)?" n; then
    setup_questions
  fi
  log INFO "setup: branch=${PZ_BRANCH} xmx=${XMX} save=${SAVE_MINUTES} net=${NETWORK_MODE} autostart=${AUTOSTART}"
  local was_running=no; server_active && was_running=yes
  NEED_RESTART=no
  if [[ $INSTALLED == yes ]]; then
    info "Repair keeps your settings: version ${PZ_BRANCH} · memory ${XMX} · auto-save ${SAVE_MINUTES} min · ${NETWORK_MODE} · start on boot ${AUTOSTART}"
    info "Your world, gameplay settings and other server settings are not touched. Only what is missing or wrong is fixed."
  fi

  step "Check system"                     preflight         &&
  step "Install packages"                 install_packages  &&
  step "Create server user '${PZ_USER}'"  create_user       &&
  step "Install SteamCMD"                 install_steamcmd  &&
  step "Project Zomboid server files"     install_server ${PZHOST_VALIDATE:+repair} &&
  step "Set server memory"                set_xmx           &&
  step "Create services and backups"      write_units       &&
  step "Create world + admin account"     first_run         &&
  step "Configure server (private, auto-save, backups)" configure_ini &&
  step "Keep laptop awake"                no_sleep          &&
  step "Laptop server mode (battery limit, Wi-Fi)" laptop_mode_apply &&
  step "Firewall"                         firewall_open     &&
  step "Low-ping network tuning"          optimize_network  &&
  step "Network (${NETWORK_MODE})"        network_setup     || { on_fail; return 1; }

  INSTALLED=yes; save_config
  echo; ok "${W}Setup complete!${N}"
  if server_active; then
    if [[ $NEED_RESTART == yes ]]; then
      info "Restarting the server so the changes are used…"
      send_console 'servermsg "Server restarts in 10 seconds for an update"' 2>/dev/null; sleep 10
      cmd_restart
    else
      ok "Server kept running — nothing needed a restart."; cmd_join
    fi
  elif [[ $was_running == yes ]] || ask_yn "Start the server now?" y; then cmd_start
  else cmd_join; fi
}

# =============================================================================
#  Server control
# =============================================================================
cmd_start() {
  require_installed || return 1; sudo_start || return 1
  if server_active; then ok "Server is already running."; cmd_join; return 0; fi
  stop_stray_servers
  local ts; ts=$(date +%s)
  info "Starting server…"
  run sudo systemctl start pzserver.service || { LAST_ERROR="Start server"; on_fail; return 1; }
  if wait_ready "$ts" 1200; then
    ok "${W}Server is up!${N}"; cmd_join
  else
    LAST_ERROR="Start server"; on_fail; return 1
  fi
}

cmd_stop() {
  require_installed || return 1; sudo_start || return 1
  server_active || { ok "Server is already stopped."; return 0; }
  info "Saving world and stopping (about 20 seconds)…"
  run sudo systemctl stop pzserver.service && ok "Server stopped and saved."
}

cmd_restart() { cmd_stop && cmd_start; }

cmd_save() {
  sudo_start || return 1
  send_console save && ok "Save requested — the world is being written to disk."
}

cmd_say() {
  sudo_start || return 1
  local m=${1:-}; [[ -z $m ]] && m=$(ask "Message to all players")
  [[ -z $m ]] && return 0
  m=${m//\"/\'}
  send_console "servermsg \"${m}\"" && ok "Message sent."
}

cmd_players() {
  sudo_start || return 1
  local ts; ts=$(date +%s)
  send_console players || return 1
  sleep 2
  echo "${W}Players online:${N}"
  sudo journalctl -q -u pzserver.service --since "@${ts}" -o cat --no-pager | sed 's/^/  /'
}

cmd_logs() {
  sudo_start || return 1
  echo "${D}Live server log — press Ctrl+C to go back.${N}"
  trap ':' INT
  sudo journalctl -u pzserver.service -f -n 100 -o cat
  trap - INT
}

cmd_status() {
  sudo_start || return 1
  echo; echo "${W}── Status ──${N}"
  if server_active; then
    local mem; mem=$(systemctl show -p MemoryCurrent --value pzserver.service)
    [[ $mem =~ ^[0-9]+$ ]] && mem="$(( mem / 1024 / 1024 )) MB" || mem="?"
    echo "  Server   : ${G}RUNNING${N} since $(systemctl show -p ActiveEnterTimestamp --value pzserver.service) · RAM ${mem}"
  else
    echo "  Server   : ${R}STOPPED${N}"
  fi
  echo "  Version  : ${PZ_BRANCH} (installed: ${INSTALLED_BRANCH:-none}) · memory limit ${XMX}"
  echo "  Autostart: ${AUTOSTART} · auto-save every ${SAVE_MINUTES} min"
  echo "  Network  : ${NETWORK_MODE}$( [[ $NETWORK_MODE == tailscale ]] && echo " · $(tailscale_ip || echo 'not connected')")"
  local last; last=$(sudo ls -1t "$BACKUP_DIR"/pz-*.tar.gz 2>/dev/null | head -1)
  echo "  Last backup: ${last:-none yet} · next: $(systemctl show -p NextElapseUSecRealtime --value pzbackup.timer 2>/dev/null)"
  echo "  Disk free: $(df -h --output=avail /home | tail -1 | tr -d ' ')"
  server_active && { echo; cmd_players; }
}

# =============================================================================
#  Join card for friends
# =============================================================================
cmd_join() {
  local ip note=""
  if [[ $NETWORK_MODE == tailscale ]]; then
    ip=$(tailscale_ip); [[ -z $ip ]] && ip="(Tailscale not connected — run Repair)"
  else
    ip=$(public_ip); [[ -z $ip ]] && ip="(could not detect — check internet)"
    note="NOTE: Jio can change this IP after a router restart — check again each session."
  fi
  local state="${R}STOPPED${N}"; server_active && state="${G}RUNNING${N}"

  local card
  card=$(cat <<EOF
================ PROJECT ZOMBOID — JOIN INFO ================

 BEFORE YOU JOIN (Windows and Mac)
  * Game version must be exactly: ${PZ_BRANCH}
    (turn OFF auto-update in GOG Galaxy / Steam)
  * Steam players: Library > Project Zomboid > Properties >
    Launch Options:  -nosteam        (GOG players: nothing to do)
$( [[ $NETWORK_MODE == tailscale ]] && cat <<EOT
  * Install Tailscale: https://tailscale.com/download
    Sign in, accept the host's share invite (email),
    and keep Tailscale CONNECTED while playing.
EOT
)

 IN THE GAME
  Main Menu > JOIN > Add server (or "Favorites" > Add):

    Server IP / Address : ${ip}
    Port                : ${GAME_PORT}
    Server password     : ${JOIN_PASSWORD}
    Username            : pick your own
    Account password    : pick your own (remember it!)

  First join creates your account with that username/password.
${note:+  $note
}
 HOST (playing on this laptop): IP 127.0.0.1, port ${GAME_PORT}
==============================================================
EOF
)
  echo; echo "$card"; echo "  Server right now: ${state}"
  ( umask 077; printf '%s\n' "$card" >"$JOIN_CARD" )
  echo "${D}Saved to ${JOIN_CARD} — send it to your friends privately (it has the password).${N}"
  if command -v wl-copy >/dev/null && [[ -n ${WAYLAND_DISPLAY:-} ]]; then
    printf '%s\n' "$card" | wl-copy && echo "${D}Also copied to clipboard.${N}"
  elif command -v xclip >/dev/null && [[ -n ${DISPLAY:-} ]]; then
    printf '%s\n' "$card" | xclip -selection clipboard && echo "${D}Also copied to clipboard.${N}"
  fi
  [[ $NETWORK_MODE == tailscale ]] && tailscale_share_help
  return 0
}

# =============================================================================
#  Backups
# =============================================================================
cmd_backup() {
  require_installed || return 1; sudo_start || return 1
  info "Backing up the world…"
  local ts; ts=$(date +%s)
  sudo systemctl start pzbackup.service; local rc=$?
  sudo journalctl -q -u pzbackup.service --since "@${ts}" -o cat --no-pager | tee -a "$LOG_FILE"
  (( rc == 0 )) && ok "Backup done." || { LAST_ERROR="Backup"; on_fail; return 1; }
}

cmd_backups_list() {  # for the GUI: name|size|date, newest first
  sudo_start || return 1
  sudo find "$BACKUP_DIR" -maxdepth 1 -name 'pz-*.tar.gz' -printf '%T@|%f|%s\n' 2>/dev/null | sort -rn \
    | while IFS='|' read -r t f sz; do
        printf '%s|%s|%s\n' "$f" "$(numfmt --to=iec "$sz" 2>/dev/null || echo "$sz")" "$(date -d "@${t%.*}" '+%a %d %b %Y, %H:%M')"
      done
}

cmd_restore() {  # pzhost restore [pz-….tar.gz --yes]
  require_installed || return 1; sudo_start || return 1
  local files=() i n f="" yes=no
  [[ ${2:-} == --yes ]] && yes=yes
  if [[ -n ${1:-} ]]; then
    [[ $1 =~ ^pz-[0-9_-]+\.tar\.gz$ ]] && sudo test -f "$BACKUP_DIR/$1" || { err "Backup not found: $1"; return 1; }
    f="$BACKUP_DIR/$1"
  else
    mapfile -t files < <(sudo ls -1t "$BACKUP_DIR"/pz-*.tar.gz 2>/dev/null)
    (( ${#files[@]} )) || { warn "No backups found in ${BACKUP_DIR}."; return 0; }
    echo "${W}Backups (newest first):${N}"
    for i in "${!files[@]}"; do echo "  $((i+1))) $(basename "${files[$i]}")"; done
    n=$(ask "Restore which one (0 = cancel)" 0)
    [[ $n =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#files[@]} )) || { info "Cancelled."; return 0; }
    f=${files[$((n-1))]}
  fi
  warn "This REPLACES the current world with $(basename "$f")."
  [[ $yes == yes ]] || ask_yn "Continue? (the current world is backed up first)" n || return 0
  local was=no; server_active && was=yes
  cmd_stop || return 1
  cmd_backup || return 1
  local keep="${ZOMBOID_DIR}/pre-restore-$(date +%F_%H%M%S)"
  run as_pz bash -c "mkdir -p '$keep' && cd '$PZ_HOME' && for p in Zomboid/Saves/Multiplayer Zomboid/Server Zomboid/db; do [ -e \"\$p\" ] && mv \"\$p\" '$keep/'; done; mkdir -p Zomboid/Saves && tar xzf '$f'" \
    || { LAST_ERROR="Restore backup"; on_fail; return 1; }
  ok "Restored $(basename "$f"). Old world kept in ${keep}"
  [[ $was == yes ]] && cmd_start
}

# New game: fresh map + characters. Keeps accounts (Zomboid/db), server settings
# and gameplay settings. The old world is moved, never deleted.
cmd_newworld() {  # flags: --yes (no typing NEW), --preset beginner|normal|hard, --no-start
  local yes=no preset="" start=yes
  while (( $# )); do
    case $1 in --yes) yes=yes ;; --preset) preset=${2:-}; shift ;; --no-start) start=no ;; esac; shift
  done
  require_installed || return 1; ensure_permission || return 1
  local save="${ZOMBOID_DIR}/Saves/Multiplayer/${SERVER_NAME}"
  local old="${ZOMBOID_DIR}/old-worlds/${SERVER_NAME}-$(date +%F_%H%M%S)"
  cat <<EOF

${W}── Start a new world ──${N}
  This starts the game over: ${W}new map, everyone makes a new character${N},
  all houses / items / zombies are reset.

  ${G}Kept:${N} usernames + passwords, join password, server and gameplay settings.
  ${G}Safe:${N} a backup is made first and the old world is moved to
        ${old}
        (not deleted — it can be put back).
EOF
  if [[ $yes != yes ]]; then
    local a; read -r -p "Type ${W}NEW${N} to start a new world (anything else = cancel): " a
    [[ $a == NEW || $a == new ]] || { info "Cancelled — nothing changed."; return 0; }
  fi

  if ! as_pz test -d "$save"; then
    err "World folder not found: $save"
    info "Saved worlds on this server:"; as_pz ls -1 "${ZOMBOID_DIR}/Saves/Multiplayer" 2>/dev/null | sed 's/^/    /'
    LAST_ERROR="New world"; return 1
  fi
  if server_active; then
    send_console 'servermsg "Server is restarting with a NEW WORLD. Make a new character when it is back."' 2>/dev/null
    sleep 3
  fi
  step "Stop server (saves the old world)" cmd_stop \
    && step "Backup old world" cmd_backup \
    && step "Move old world aside" as_pz bash -c "mkdir -p '${ZOMBOID_DIR}/old-worlds' && mv '$save' '$old'" \
    || { on_fail; return 1; }
  ok "Old world kept in ${old}"
  log INFO "new world: old save moved to $old"

  if [[ -n $preset ]]; then
    gp_load && gp_apply_kv preset "$preset" && gp_save && ok "Gameplay preset '${preset}' applied"
    rm -f "$GP_TMP"
  elif [[ $yes != yes ]] && ask_yn "Change gameplay settings first? (e.g. the Beginner preset — best done before the world is made)" y; then
    cmd_gameplay
  fi
  if [[ $start == yes ]] && ask_yn "Start the server and create the new world now? (first start takes a few extra minutes)" y; then
    cmd_start
  else
    info "The new world is created the next time you choose 1) Start."
  fi
  echo
  info "To put the old world back: stop the server, then run"
  echo "    sudo -u ${PZ_USER} mv '${save}' '${save}-new-$(date +%F)'"
  echo "    sudo -u ${PZ_USER} mv '${old}' '${save}'"
  info "Old worlds use disk space. Delete ones you don't need with:  sudo rm -r '${ZOMBOID_DIR}/old-worlds/<name>'"
}

