# =============================================================================
#  Gameplay (sandbox) settings — servertest_SandboxVars.lua
#  Only keys that already exist in the file are changed, so this keeps working
#  if a game update renames or moves an option (it is simply skipped).
# =============================================================================
sandbox_file() { echo "${ZOMBOID_DIR}/Server/${SERVER_NAME}_SandboxVars.lua"; }

# sb_awk get|set TABLE KEY [VALUE] < file
#   TABLE "" = any table, otherwise the innermost table must have that name.
#   KEY "*Suffix" matches every key ending in Suffix (e.g. *LootNew).
#   get prints the first value; set prints the whole file. Exit 3 = key not found.
sb_awk() {
  awk -v mode="$1" -v sect="$2" -v key="$3" -v val="${4:-}" '
    BEGIN {
      d = 0; n = 0
      if (substr(key, 1, 1) == "*") re = "^[ \t]*[A-Za-z0-9_]*" substr(key, 2) "[ \t]*=[ \t]*"
      else re = "^[ \t]*" key "[ \t]*=[ \t]*"
    }
    {
      line = $0
      if (line ~ /=[ \t]*\{[ \t]*$/) {
        nm = line; sub(/^[ \t]*/, "", nm); sub(/[ \t]*=.*$/, "", nm); st[++d] = nm
        if (mode == "set") print line
        next
      }
      if (line ~ /^[ \t]*\},?[ \t]*$/) { if (d > 0) d--; if (mode == "set") print line; next }
      if ((sect == "" || (d > 0 && st[d] == sect)) && match(line, re)) {
        pre = substr(line, 1, RLENGTH); rest = substr(line, RLENGTH + 1)
        v = rest; sub(/,?[ \t]*$/, "", v)
        n++
        if (mode == "get" && n == 1) print v
        if (mode == "set") line = pre val ((rest ~ /,[ \t]*$/) ? "," : "")
      }
      if (mode == "set") print line
    }
    END { exit (n > 0 ? 0 : 3) }'
}

GP_TMP=""; GP_DIRTY=no; GP_SKIPPED=()
gp_get() { sb_awk get "$1" "$2" <"$GP_TMP"; }
gp_set() {  # gp_set TABLE KEY VALUE — edit the working copy; returns 1 if the key isn't in this game version
  local out
  if out=$(sb_awk set "$1" "$2" "$3" <"$GP_TMP"); then
    printf '%s\n' "$out" >"$GP_TMP"; GP_DIRTY=yes; log INFO "gameplay: ${1:+$1.}$2 = $3"; return 0
  fi
  GP_SKIPPED+=("$2"); log WARN "gameplay: key $2 not found in sandbox file — skipped"; return 1
}
gp_has() { gp_get "$1" "$2" >/dev/null; }

# --- one function per option: set + human-readable label ---------------------
gp_pop_set() {  # multiplier
  local m=$1 z
  z=$(awk -v m="$m" 'BEGIN{print (m==0)?6:(m<=0.45)?5:(m<=0.9)?4:(m<=1.3)?3:(m<=1.8)?2:1}')
  gp_set "" PopulationMultiplier "$m"
  gp_has SandboxVars Zombies && gp_set SandboxVars Zombies "$z"
}
gp_pop_label() {
  local v; v=$(gp_get "" PopulationMultiplier) || { echo "?"; return; }
  awk -v m="$v" 'BEGIN{l=(m==0)?"None":(m<=0.2)?"Very few":(m<=0.45)?"Few":(m<=0.9)?"Normal":(m<=1.3)?"Many":(m<=1.8)?"Very many":"Insane"; printf "%s (%sx)", l, m}'
}
gp_speed_label() {
  case $(gp_get ZombieLore Speed) in
    1) echo "Sprinters (very hard)" ;; 2) echo "Fast shamblers (normal)" ;;
    3) echo "Shamblers / slow (easiest)" ;; 4) echo "Random mix" ;; *) echo "?" ;;
  esac
}
gp_strength_label() {
  case $(gp_get ZombieLore Strength) in
    1) echo "Superhuman (hard)" ;; 2) echo "Normal" ;; 3) echo "Weak (easier)" ;; *) echo "?" ;;
  esac
}
gp_infect_label() {
  case $(gp_get ZombieLore Transmission) in
    1) echo "Bites + scratches can infect (normal)" ;; 2) echo "Only bites infect (easier)" ;;
    3) echo "Everyone is already infected" ;; 4) echo "Never infected (easiest)" ;; *) echo "?" ;;
  esac
}
gp_day_label() {
  local v; v=$(gp_get "" DayLength)
  case $v in
    1) echo "15 min" ;; 2) echo "30 min" ;; 3) echo "1 hour (normal)" ;; 4) echo "1.5 hours" ;;
    5) echo "2 hours" ;; 6) echo "3 hours" ;; 7) echo "4 hours" ;; "") echo "?" ;; *) echo "custom (${v})" ;;
  esac
}
gp_xp_set() {  # Build 42: MultiplierConfig.Global, Build 41: XpMultiplier
  local done=no
  if gp_has MultiplierConfig Global; then
    gp_set MultiplierConfig Global "$1" && done=yes
    gp_has MultiplierConfig GlobalToggle && gp_set MultiplierConfig GlobalToggle true
  fi
  if gp_has "" XpMultiplier; then gp_set "" XpMultiplier "$1" && done=yes; fi
  [[ $done == yes ]] || GP_SKIPPED+=("XP")
}
gp_xp_label() {
  local v; v=$(gp_get MultiplierConfig Global) || v=$(gp_get "" XpMultiplier) || { echo "?"; return; }
  echo "${v}x"
}
gp_loot_set() { gp_set "" "*LootNew" "$1"; }
gp_loot_label() {
  local v; v=$(gp_get "" "*LootNew") || { echo "?"; return; }
  awk -v m="$v" 'BEGIN{l=(m<=0.35)?"Rare":(m<=0.8)?"Normal":(m<=1.5)?"Plenty":"Lots"; printf "%s (%sx)", l, m}'
}
gp_utils_set() { gp_set "" WaterShutModifier "$1"; gp_set "" ElecShutModifier "$1"; }
gp_utils_label() { local v; v=$(gp_get "" WaterShutModifier) || { echo "?"; return; }; echo "about ${v} days"; }
gp_night_label() {
  case $(gp_get "" NightDarkness) in
    1) echo "Pitch black" ;; 2) echo "Dark" ;; 3) echo "Normal" ;; 4) echo "Bright (easier)" ;; *) echo "?" ;;
