    return 0
  fi
  command -v nmcli >/dev/null || { echo "wifi=${dev}"; return 0; }
  con=$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null)
  echo "wifi=${con:-?}"
