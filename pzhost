        && $(nmcli -g 802-11-wireless-security.psk-flags connection show "$con" 2>/dev/null) == 0* ]]; then
    echo "wifi_boot=yes"; else echo "wifi_boot=no"; fi
  if [[ $(nmcli -g 802-11-wireless.powersave connection show "$con" 2>/dev/null) == 2* || -f $NM_WIFI_CONF ]]; then
    echo "wifi_powersave=off"; else echo "wifi_powersave=on"; fi
  echo "wifi_signal=$(nmcli -t -f IN-USE,SIGNAL device wifi list --rescan no 2>/dev/null | awk -F: '$1=="*"{print $2; exit}')"
}

