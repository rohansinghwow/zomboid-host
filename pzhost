cmd_gameplay_set() {  # pzhost gameplay-set key=value… (restarts the server if it is running)
  require_installed || return 1; ensure_permission || return 1; gp_load || return 1
  local kv
  for kv in "$@"; do
    [[ $kv == *=* ]] || continue
    gp_apply_kv "${kv%%=*}" "${kv#*=}" || { rm -f "$GP_TMP"; return 1; }
  done
  (( ${#GP_SKIPPED[@]} )) && warn "Not in this game version, skipped: ${GP_SKIPPED[*]}"
  if [[ $GP_DIRTY == yes ]]; then gp_save || { rm -f "$GP_TMP"; return 1; }
  else ok "Nothing changed."; fi
  rm -f "$GP_TMP"; return 0
}

cmd_gameplay() {
  require_installed || return 1; ensure_permission || return 1
  local f; f=$(sandbox_file)
  gp_load || return 1
  local c
  while :; do
    GP_SKIPPED=()
    echo; echo "${W}── Gameplay settings ──${N}  $( [[ $GP_DIRTY == yes ]] && echo "${Y}(unsaved changes)${N}")"
    cat <<EOF
  ${D}New to Project Zomboid? Pick 1) Beginner — you can change single options after.${N}

  ${W}Quick presets${N}
   1) ${G}Beginner${N}  few slow weak zombies, only bites infect, 2x XP, more loot,
                 longer days, water/power stay on ~3 months, starter bag, +4 trait points
   2) Normal    the game's standard "Apocalypse" settings
   3) Hard      more zombies, less loot, darker nights, power/water off after a week

  ${W}Change one thing${N}                       ${D}current${N}
   4) How many zombies                    $(gp_pop_label)
   5) Zombie speed                        $(gp_speed_label)
   6) Zombie strength / toughness         $(gp_strength_label)
   7) Infection                           $(gp_infect_label)
   8) Length of one in-game day           $(gp_day_label)
   9) Skill learning speed (XP)           $(gp_xp_label)
  10) Amount of loot                      $(gp_loot_label)
  11) Water & electricity stay on for     $(gp_utils_label)
  12) Night darkness                      $(gp_night_label)
  13) Injury severity                     $(gp_injury_label)
  14) Starter bag on spawn                $(gp_kit_label)
  15) Extra trait points for characters   $(gp_points_label)

   ${W}s) Save and apply${N}          0) Back
  ${D}Note: loot changes only fill containers nobody has opened yet. Water/power
  can't come back once they have already shut off in your world.${N}
EOF
    local p=""
    c=$(ask "Choose" 0)
    case $c in
      1) gp_preset beginner; ok "Beginner preset ready — choose ${W}s${N} to save." ;;
      2) gp_preset normal;   ok "Normal preset ready — choose ${W}s${N} to save." ;;
      3) gp_preset hard;     ok "Hard preset ready — choose ${W}s${N} to save." ;;
      4) p=$(gp_pick "How many zombies?" "None (just exploring / building)" "Very few" \
               "Few ${G}(recommended for beginners)${N}" "Normal" "Many" "Very many" "Insane")
         case $p in 1) gp_pop_set 0 ;; 2) gp_pop_set 0.15 ;; 3) gp_pop_set 0.35 ;; 4) gp_pop_set 0.65 ;;
                    5) gp_pop_set 1.2 ;; 6) gp_pop_set 1.6 ;; 7) gp_pop_set 2.5 ;; esac ;;
      5) p=$(gp_pick "Zombie speed?" "Sprinters (very hard)" "Fast shamblers (normal)" \
               "Shamblers / slow ${G}(recommended for beginners)${N}" "Random mix")
         [[ -n $p ]] && gp_set ZombieLore Speed "$p" ;;
      6) p=$(gp_pick "Zombie strength and toughness?" "Superhuman (hard)" "Normal" \
               "Weak ${G}(recommended for beginners)${N}")
         [[ -n $p ]] && { gp_set ZombieLore Strength "$p"; gp_set ZombieLore Toughness "$p"; } ;;
      7) p=$(gp_pick "How does infection work?" "Bites + scratches can infect (normal)" \
               "Only bites infect ${G}(recommended for beginners)${N}" \
               "Everyone is already infected (you turn when you die)" "Never infected (easiest)")
         [[ -n $p ]] && gp_set ZombieLore Transmission "$p" ;;
      8) p=$(gp_pick "How long is one in-game day (real time)?" "30 min" "1 hour (normal)" \
               "1.5 hours ${G}(recommended for beginners)${N}" "2 hours" "3 hours")
         case $p in 1) gp_set "" DayLength 2 ;; 2) gp_set "" DayLength 3 ;; 3) gp_set "" DayLength 4 ;;
                    4) gp_set "" DayLength 5 ;; 5) gp_set "" DayLength 6 ;; esac ;;
      9) p=$(gp_pick "How fast do skills level up?" "1x (normal)" "2x ${G}(recommended for beginners)${N}" "3x" "5x")
         case $p in 1) gp_xp_set 1.0 ;; 2) gp_xp_set 2.0 ;; 3) gp_xp_set 3.0 ;; 4) gp_xp_set 5.0 ;; esac ;;
     10) p=$(gp_pick "How much loot?" "Rare (hard)" "Normal" "Plenty ${G}(recommended for beginners)${N}" "Lots")
         case $p in 1) gp_loot_set 0.3 ;; 2) gp_loot_set 0.6 ;; 3) gp_loot_set 1.0 ;; 4) gp_loot_set 2.0 ;; esac ;;
     11) p=$(gp_pick "Water & electricity stay on for about…" "1 week (hard)" "2 weeks (normal)" \
               "3 months ${G}(recommended for beginners)${N}" "1 year")
         case $p in 1) gp_utils_set 7 ;; 2) gp_utils_set 14 ;; 3) gp_utils_set 90 ;; 4) gp_utils_set 365 ;; esac ;;
     12) p=$(gp_pick "How dark are nights?" "Pitch black" "Dark" "Normal ${G}(recommended)${N}" "Bright")
         [[ -n $p ]] && gp_set "" NightDarkness "$p" ;;
     13) p=$(gp_pick "How bad are injuries?" "Low ${G}(recommended for beginners)${N}" "Normal" "High")
         [[ -n $p ]] && gp_set "" InjurySeverity "$p" ;;
     14) p=$(gp_pick "Start with a bag of basic supplies?" "Yes ${G}(recommended for beginners)${N}" "No")
         case $p in 1) gp_set "" StarterKit true ;; 2) gp_set "" StarterKit false ;; esac ;;
     15) p=$(gp_pick "Extra trait points when making a character?" "0 (normal)" \
               "+4 ${G}(recommended for beginners)${N}" "+8")
         case $p in 1) gp_set "" CharacterFreePoints 0 ;; 2) gp_set "" CharacterFreePoints 4 ;; 3) gp_set "" CharacterFreePoints 8 ;; esac ;;
      s|S) if [[ $GP_DIRTY == yes ]]; then gp_save && { GP_DIRTY=no; as_pz cat "$f" >"$GP_TMP"; }
           else info "Nothing changed."; fi ;;
      0|q|"")
         if [[ $GP_DIRTY == yes ]] && ask_yn "You have unsaved changes. Save them now?" y; then gp_save; fi
         rm -f "$GP_TMP"; return 0 ;;
      *) warn "Unknown choice." ;;
    esac
    (( ${#GP_SKIPPED[@]} )) && warn "Not in this game version, skipped: ${GP_SKIPPED[*]}"
  done
}

cmd_update_server() {  # [--check] — download only if Steam has a newer build (or another version was chosen)
  local check=no; [[ ${1:-} == --check ]] && check=yes
  require_installed || return 1; ensure_permission || return 1
  install_steamcmd || return 1
  local have latest build
  have=$(installed_branch) || have=$INSTALLED_BRANCH
  build=$(installed_build)
  info "Installed: version ${have:-?} (build ${build:-?}). Asking Steam for the newest '${PZ_BRANCH}'…"
  latest=$(steam_latest_build "${PZ_BRANCH:-public}")
  echo "installed_branch=${have} installed_build=${build} latest_build=${latest:-unknown}"
  if [[ $have == "${PZ_BRANCH:-public}" && -n $latest && $latest == "$build" ]] && server_files_ok; then
    ok "Already up to date — nothing to download."
    echo "update=no"; return 0
  fi
  if [[ $check == yes ]]; then
    [[ $have != "${PZ_BRANCH:-public}" ]] && info "Version change: ${have} → ${PZ_BRANCH}" || info "A newer build is available (${build:-?} → ${latest:-?})."
    echo "update=yes"; return 0
  fi
  warn "All friends must have the same game version (${PZ_BRANCH}) to join."
  warn "GOG players: GOG often gets new versions later than Steam. Only update when everyone's GOG game"
  warn "shows the same new version in its main menu — otherwise nobody can join until GOG catches up."
  if [[ -t 0 ]] && ! ask_yn "Update the server now?" n; then info "Not updated."; return 0; fi
  local was=no; server_active && was=yes
  NEED_RESTART=no
  step "Update server files" install_server update && step "Re-apply memory setting" set_xmx || { on_fail; return 1; }
  ok "Server is on version ${PZ_BRANCH} (build $(installed_build))."
  [[ $was == yes ]] && cmd_start
  return 0
}

source_dir() { cat "${CONF_DIR}/source_dir" 2>/dev/null; }

update_available() {
  local src; src=$(source_dir)
  [[ -d $src/.git ]] || return 1
  timeout 6 git -C "$src" fetch -q 2>/dev/null || return 1
  [[ $(git -C "$src" rev-parse HEAD) != "$(git -C "$src" rev-parse '@{u}' 2>/dev/null)" ]]
}

cmd_self_update() {
  local src; src=$(source_dir)
  [[ -d $src/.git ]] || { err "App source folder not found (${src:-unknown}). Re-clone the repo and run install.sh."; return 1; }
  info "Updating app from GitHub…"
  run git -C "$src" pull --ff-only || { LAST_ERROR="Update app"; on_fail; return 1; }
  run bash "$src/install.sh" --no-launch || { LAST_ERROR="Update app"; on_fail; return 1; }
  ok "App updated to $(git -C "$src" log -1 --format='%h %s')"
  [[ ${PZHOST_GUI:-} == 1 ]] && return 0   # the app restarts itself
  release_lock
  if [[ $INSTALLED == yes ]] && ask_yn "Re-apply server settings with the new version (Repair)?" y; then
    exec /usr/local/bin/pzhost setup
  fi
  exec /usr/local/bin/pzhost
}

cmd_uninstall() {  # flags: --yes, --delete-world (GUI)
  local yes=no delworld=no a
  for a in "$@"; do [[ $a == --yes ]] && yes=yes; [[ $a == --delete-world ]] && delworld=yes; done
  ensure_permission || return 1
  warn "This removes the services, power and firewall changes made by pzhost."
  [[ $yes == yes ]] || ask_yn "Continue?" n || return 0
  server_active && cmd_stop
  sudo systemctl disable --now pzserver.service pzbackup.timer pzrestart.timer 2>/dev/null
  sudo rm -f "${UNIT_DIR}"/pzserver.{service,socket} "${UNIT_DIR}"/pzbackup.{service,timer} "${UNIT_DIR}"/pzrestart.{service,timer}
  [[ -x $BATTERY_SCRIPT ]] && sudo "$BATTERY_SCRIPT" 100 >/dev/null 2>&1   # back to normal charging
  sudo systemctl disable pzbattery.service 2>/dev/null; sudo rm -f "$BATTERY_UNIT"
  sudo systemctl disable --now pzwifi-watchdog.timer 2>/dev/null
  sudo rm -f "${UNIT_DIR}"/pzwifi-watchdog.{service,timer} "$WIFI_MODPROBE"
  sudo rm -rf "${UNIT_DIR}/pzserver.service.d" "$LIB_DIR"
  sudo systemctl daemon-reload
  sudo rm -f "$SYSCTL_FILE" "$NM_WIFI_CONF"; sudo systemctl reload NetworkManager 2>/dev/null
  sudo rm -f "$LOGIND_DROPIN"; sudo systemctl unmask "${SLEEP_TARGETS[@]}"; sudo systemctl kill -s HUP systemd-logind 2>/dev/null
  if command -v ufw >/dev/null; then
    sudo ufw delete allow "${GAME_PORT}:${UDP_PORT}/udp" >/dev/null 2>&1
    sudo ufw delete allow in on tailscale0 >/dev/null 2>&1
    sudo ufw delete allow "${TS_PORT}/udp" >/dev/null 2>&1
  fi
  if systemctl is-active -q firewalld; then
    sudo firewall-cmd --permanent --remove-port="${GAME_PORT}-${UDP_PORT}/udp" >/dev/null 2>&1
    sudo firewall-cmd --permanent --zone=trusted --remove-interface=tailscale0 >/dev/null 2>&1
    sudo firewall-cmd --permanent --remove-port="${TS_PORT}/udp" >/dev/null 2>&1
    sudo firewall-cmd --reload >/dev/null 2>&1
  fi
  ok "Services, power, network tuning and firewall changes removed."
  if [[ $delworld == yes ]] || { [[ $yes != yes ]] && ask_yn "ALSO delete the server files AND THE WORLD in ${PZ_HOME}? (cannot be undone)" n; }; then
    local copy="${HOME}/zomboid-world-backup-$(date +%F_%H%M).tar.gz"
    info "Saving a copy of the world to ${copy} first…"
    sudo tar czf "$copy" -C "$PZ_HOME" Zomboid backups 2>/dev/null; sudo chown "$(id -u):$(id -g)" "$copy"
    sudo userdel -r "$PZ_USER" && ok "Server user and files deleted."
  fi
  INSTALLED=no; INSTALLED_BRANCH=""; PERMISSION_GRANTED=no; save_config
  ok "Uninstalled. The app itself stays (remove: sudo rm /usr/local/bin/pzhost)."
}

# =============================================================================
#  Error report → GitHub issue
# =============================================================================
redact() {  # redact FILE
  local f=$1 s
  for s in "$JOIN_PASSWORD" "$ADMIN_PASSWORD" "${PUBLIC_IP_CACHE:-}"; do
    [[ -n $s ]] && sed -i "s/${s//./\\.}/[REDACTED]/g" "$f"
  done
  sed -E -i \
    -e 's/\x1b\[[0-9;]*m//g' \
    -e 's/(Password=).*/\1[REDACTED]/' \
    -e 's/(-adminpassword )[^ "]+/\1[REDACTED]/g' \
    -e 's/(gh[opsu]_)[A-Za-z0-9]+/\1[REDACTED]/g' \
    -e 's/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}/[EMAIL]/g' \
    -e 's/tskey-[A-Za-z0-9-]+/[REDACTED]/g' \
    -e 's/(PASSWORD=).*/\1[REDACTED]/' "$f"
}

on_fail() {
  echo
  err "Something went wrong at: ${LAST_ERROR:-unknown step}"
  echo "  Full log: ${LOG_FILE}"
  if [[ -t 0 ]] && ask_yn "Send an error report to GitHub so it can be fixed?" y; then
    cmd_report
  else
    echo "  You can send it later from the menu: ${W}Send error report${N} (or: pzhost report)"
  fi
}

section() {  # section "Title" cmd... — fenced output block for the report
  printf '\n### %s\n~~~text\n' "$1"
  shift
  "$@" 2>&1 | tail -n 400
  printf '~~~\n'
}

cmd_report() {
  sudo -n true 2>/dev/null || sudo_start || true
  local desc f title
  echo; echo "${W}Error report${N} — passwords, emails and your public IP are removed automatically."
  echo "${D}Note: reports are PUBLIC GitHub issues — don't type private info in the description.${N}"
  if [[ -n ${PZHOST_REPORT_DESC:-} ]]; then desc=$PZHOST_REPORT_DESC
  else desc=$(ask "In a few words: what were you doing / what went wrong?" ""); fi
  PUBLIC_IP_CACHE=$(public_ip)
  f="${STATE_DIR}/report-$(date +%F_%H%M%S).md"
  {
    echo "## pzhost error report"
    echo "- **App version:** ${PZHOST_VERSION} ($(git -C "$(source_dir)" log -1 --format='%h %cd' --date=short 2>/dev/null || echo 'no git'))"
    echo "- **Date:** $(date '+%F %T %Z')"
    echo "- **Failed step:** ${LAST_ERROR:-none (manual report)}"
    echo "- **User says:** ${desc:-(nothing)}"
    section "System" bash -c '. /etc/os-release; echo "$PRETTY_NAME"; uname -a; echo; lscpu | grep -E "Model name|^CPU\(s\)"; echo; free -h; echo; df -h /home /'
    section "pzhost config (passwords redacted)" cat "$CONF"
    section "Services" bash -c 'systemctl --no-pager status pzserver.service pzserver.socket pzbackup.timer pzrestart.timer 2>&1 | head -60; echo; systemctl list-timers --no-pager "pz*"'
    section "Server files" sudo -n bash -c "ls -la '${PZ_HOME}' '${SERVER_DIR}' 2>&1 | head -60; echo; grep -o '\"-Xm[sx][^\"]*\"' '${SERVER_DIR}/ProjectZomboid64.json' 2>&1"
    section "Server ini (passwords redacted)" sudo -n grep -E '^(Public|Password|MaxPlayers|DefaultPort|UDPPort|SaveWorldEveryMinutes|Backups|Mods|WorkshopItems|Map)' "${ZOMBOID_DIR}/Server/${SERVER_NAME}.ini"
    section "Firewall" bash -c 'command -v ufw >/dev/null && sudo -n ufw status verbose; systemctl is-active firewalld >/dev/null 2>&1 && sudo -n firewall-cmd --list-all; true'
    section "Network" bash -c "echo mode=${NETWORK_MODE}; ip -4 -br addr; echo; command -v tailscale >/dev/null && tailscale status --peers=false 2>&1; true"
    section "Ping check" cmd_pingcheck
    section "Network tuning" bash -c "cat '${SYSCTL_FILE}' '${NM_WIFI_CONF}' 2>&1"
    section "Power / sleep" bash -c "cat '${LOGIND_DROPIN}' 2>&1; systemctl is-enabled ${SLEEP_TARGETS[*]} 2>&1"
    section "Battery" bash -c "cat /sys/class/dmi/id/sys_vendor /sys/class/dmi/id/product_name 2>&1; grep -H . /sys/class/power_supply/*/{online,capacity,status,charge_control_*_threshold,charge_types} /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode 2>/dev/null; systemctl is-enabled pzbattery.service 2>&1; true"
    section "pzhost log (last 300 lines)" tail -n 300 "$LOG_FILE"
    section "Server journal (last 250 lines)" sudo -n journalctl -u pzserver.service -n 250 --no-pager -o short-iso
    section "Server console.txt (last 150 lines)" sudo -n tail -n 150 "${ZOMBOID_DIR}/server-console.txt"
    section "Backup journal (last 30 lines)" sudo -n journalctl -u pzbackup.service -n 30 --no-pager -o short-iso
  } >"$f" 2>&1
  redact "$f"
  # GitHub issue bodies are limited to 65536 characters.
  if (( $(wc -c <"$f") > 60000 )); then
    head -c 60000 "$f" >"$f.tmp" && printf '\n~~~\n\n_(report truncated — full file kept on the host at %s)_\n' "$f" >>"$f.tmp" && mv "$f.tmp" "$f.body"
  else
    cp "$f" "$f.body"
  fi
  log INFO "report written: $f"
  ok "Report saved: $f"

  title="Error report: ${LAST_ERROR:-manual} ($(date +%F))"
  if ! command -v gh >/dev/null; then
    report_fallback "$f"; return 0
  fi
  if ! gh auth status >/dev/null 2>&1; then
    warn "GitHub CLI is not logged in."
    if ask_yn "Log in to GitHub now (opens a browser code)?" y; then gh auth login --hostname github.com --git-protocol https --web || { report_fallback "$f"; return 0; }
    else report_fallback "$f"; return 0; fi
  fi
  info "Creating GitHub issue on ${REPO}…"
  local url
  url=$(gh issue create --repo "$REPO" --title "$title" --body-file "$f.body" --label error-report 2>>"$LOG_FILE") \
    || url=$(gh issue create --repo "$REPO" --title "$title" --body-file "$f.body" 2>>"$LOG_FILE")
  if [[ -n $url ]]; then
    ok "Report sent: ${url}"
    log INFO "report sent: $url"
    echo "  When it's fixed, choose ${W}Update this app${N} in the menu."
  else
    err "Could not create the issue (no access to ${REPO}?)."
    report_fallback "$f"
  fi
}

report_fallback() {
  cat <<EOF

  Send the report manually:
   1. Open ${C}https://github.com/${REPO}/issues/new${N}
   2. Title: "Error report"
   3. Drag this file into the text box: ${W}$1${N}
EOF
}

# =============================================================================
#  Menu
# =============================================================================
header() {
  clear 2>/dev/null
  local st="${R}● STOPPED${N}"; server_active && st="${G}● RUNNING${N}"
  [[ $INSTALLED != yes ]] && st="${Y}● NOT INSTALLED${N}"
  echo "${W}┌──────────────────────────────────────────────────────┐${N}"
  printf '%s│  🧟 Zomboid Host  v%-8s  Server: %s%s\n' "$W" "$PZHOST_VERSION" "$st" "$N"
  echo "${W}└──────────────────────────────────────────────────────┘${N}"
  [[ ${UPDATE_FLAG:-} == yes ]] && echo "${Y}  ⬆ An app update is available — choose 15) Update this app${N}"
}

menu() {
  UPDATE_FLAG=no; update_available && UPDATE_FLAG=yes
  while :; do
    load_config
    header
    if [[ $INSTALLED != yes ]]; then
      cat <<EOF

  1) ${W}Set up the server (first time)${N}
  2) Network check (does Jio allow port forwarding?)
  5) Ping check
  3) Send error report to GitHub
  4) Update this app
  0) Quit
EOF
      case $(ask "Choose" 1) in
        1) acquire_lock "setup" && { cmd_setup; release_lock; } ;; 2) cmd_netcheck ;; 3) cmd_report ;;
        4) acquire_lock "app update" && cmd_self_update; release_lock ;; 5) cmd_pingcheck ;; 0|q) exit 0 ;;
      esac
      pause; continue
    fi
    cat <<EOF

  ${W}Server${N}                          ${W}World${N}
   1) Start                          7) Save now
   2) Stop                           8) Backup now
   3) Restart                        9) Restore a backup
   4) ${W}Join info for friends${N}     19) ${W}Gameplay settings${N} (zombies, loot, XP)
                                    20) ${W}Start a new world${N} (reset game)
                                    21) ${W}Laptop server mode${N} (battery 80%, no sleep)
   5) Status & players            ${W}Help / maintenance${N}
   6) Message all players           10) Live server log
                                    11) Settings
                                    12) Network check
                                    13) Update game version
                                    14) Send error report
                                    15) Update this app
                                    16) Repair (re-run setup)
                                    17) Uninstall
                                    18) ${W}Ping check${N}
   0) Quit
EOF
    local choice; choice=$(ask "Choose" 4)
    case $choice in
      1|2|3|8|9|11|13|15|16|17|19|20|21) acquire_lock "menu option ${choice}" || { pause; continue; } ;;
    esac
    case $choice in
      1) cmd_start ;; 2) cmd_stop ;; 3) cmd_restart ;; 4) cmd_join ;; 5) cmd_status ;;
      6) cmd_say ;; 7) cmd_save ;; 8) cmd_backup ;; 9) cmd_restore ;; 10) cmd_logs ;;
      11) cmd_settings ;; 12) cmd_netcheck ;; 13) cmd_update_server ;; 14) cmd_report ;;
      15) cmd_self_update ;; 16) cmd_setup ;; 17) cmd_uninstall ;; 18) cmd_pingcheck ;; 19) cmd_gameplay ;; 20) cmd_newworld ;; 21) cmd_laptop ;; 0|q) exit 0 ;;
      *) warn "Unknown choice." ;;
    esac
    release_lock
    pause
  done
}

usage() {
  cat <<EOF
pzhost ${PZHOST_VERSION} — Project Zomboid server manager for Debian 13 / Ubuntu / Arch

  pzhost                 interactive menu
  pzhost setup           install / repair everything (asks permission first)
  pzhost start|stop|restart
  pzhost join            show + save join info for friends
  pzhost status          status, players, backups
  pzhost players         list online players
  pzhost say "text"      message all players
  pzhost save            save world now
  pzhost backup          backup now
  pzhost restore         restore a backup
  pzhost new-world       start the game over on a fresh map (keeps accounts + settings)
  pzhost logs            live server log
  pzhost settings        change passwords, memory, version, network
  pzhost gameplay        gameplay settings: zombies, loot, XP (beginner preset)
  pzhost netcheck        Jio CGNAT / port forwarding check
  pzhost ping            ping / Wi-Fi / Tailscale direct-vs-relay check
  pzhost laptop          laptop server mode: battery limit, no sleep, Wi-Fi auto-connect
  pzhost update-server   change/update the game server version
  pzhost report          send an error report to GitHub
  pzhost self-update     update this app from GitHub
  pzhost uninstall       undo everything
  pzhost version
EOF
}

main() {
  if [[ $EUID -eq 0 ]]; then
    echo "Run pzhost as your normal user (not root / not with sudo). It asks for your password when needed." >&2
    exit 1
  fi
  load_config
  log INFO "──── pzhost ${PZHOST_VERSION} started: ${*:-menu} (user $(id -un))"
  local cmd=${1:-menu}; shift || true
  case $cmd in
    setup|repair|start|stop|restart|backup|restore|update-server|new-world|newworld|reset|gameplay-set|set|\
    uninstall|self-update|update|laptop-apply|laptop-limit)
      acquire_lock "$cmd" || exit 1 ;;
  esac
  case $cmd in
    menu)          menu ;;
    setup|repair)  cmd_setup ;;
    start)         cmd_start ;;
    stop)          cmd_stop ;;
    restart)       cmd_restart ;;
    join|info)     cmd_join ;;
    status)        cmd_status ;;
    players)       cmd_players ;;
    say|msg)       cmd_say "$*" ;;
    save)          cmd_save ;;
    backup)        cmd_backup ;;
    restore)       cmd_restore "$@" ;;
    new-world|newworld|reset) cmd_newworld "$@" ;;
    logs|log)      cmd_logs ;;
    settings)      cmd_settings ;;
    gameplay|sandbox) cmd_gameplay ;;
    netcheck)      cmd_netcheck ;;
    ping|pingcheck) cmd_pingcheck ;;
    laptop|battery) cmd_laptop ;;
    laptop-apply)  cmd_laptop_apply ;;
    laptop-limit)  cmd_laptop_limit "${1:-}" ;;
    gameplay-get)  cmd_gameplay_get ;;
    gameplay-set)  cmd_gameplay_set "$@" ;;
    backups)       cmd_backups_list ;;
    set)           cmd_set "$@" ;;
    gui-status)    cmd_gui_status ;;
    gui-log)       cmd_gui_log "${1:-300}" ;;
    permission-text) N='' W='' show_permission_screen ;;
    update-check)  if update_available; then echo "update=yes"; else echo "update=no"; fi ;;
    gui)           exec /usr/local/bin/pzhost-gui ;;
    update-server) cmd_update_server "$@" ;;
    report)        cmd_report ;;
    self-update|update) cmd_self_update ;;
    uninstall)     cmd_uninstall "$@" ;;
    version|-v|--version) echo "pzhost ${PZHOST_VERSION}" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
  esac
}

main "$@"
