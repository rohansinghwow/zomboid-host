# Wait for "SERVER STARTED" in the journal since timestamp $1, timeout $2 seconds.
wait_ready() {
  local since=$1 timeout=$2 t0 el last
  t0=$(date +%s)
  while :; do
    if sudo journalctl -q -u pzserver.service --since "@${since}" -o cat --no-pager 2>/dev/null | grep -q "SERVER STARTED"; then
      printf '\n'; return 0
    fi
    if ! server_active; then
      printf '\n'; err "Server stopped unexpectedly. Last log lines:"
      sudo journalctl -q -u pzserver.service --since "@${since}" -o cat --no-pager -n 40 | tee -a "$LOG_FILE"
      return 1
    fi
    el=$(( $(date +%s) - t0 ))
    if (( el > timeout )); then printf '\n'; err "Server did not finish starting within ${timeout}s."; return 1; fi
    last=$(sudo journalctl -q -u pzserver.service --since "@${since}" -o cat --no-pager -n 1 2>/dev/null | cut -c1-60)
    printf '\r  %s⏳ %4ds%s  %-60s' "$Y" "$el" "$N" "$last"
    sleep 5
  done
}

first_run() {
