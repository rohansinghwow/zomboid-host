gp_pick() {  # gp_pick "Title" "label1" "label2" … → prints chosen number (empty = keep)
  local title=$1 i=1 o; shift
  echo >&2; echo "  ${W}${title}${N}" >&2
  for o in "$@"; do echo "    ${i}) ${o}" >&2; ((i++)); done
  local c; c=$(ask "  Choose (Enter = keep current)" "")
  [[ $c =~ ^[0-9]+$ ]] && (( c >= 1 && c <= $# )) && echo "$c"
}

gp_save() {
  local f; f=$(sandbox_file)
  local was=no; server_active && was=yes
  if [[ $was == yes ]]; then
    warn "The server must restart to use the new settings (players will be kicked for ~1 minute)."
    ask_yn "Restart the server now?" y || { info "Not saved. Nothing changed."; return 1; }
    cmd_stop || return 1
  fi
  as_pz cp "$f" "${f}.bak-$(date +%F-%H%M%S)" || { err "Could not back up the settings file."; return 1; }
  as_pz tee "$f" <"$GP_TMP" >/dev/null || { err "Could not write the settings file."; return 1; }
  ok "Gameplay settings saved (old file kept as ${f##*/}.bak-…)."
  if [[ $was == yes ]]; then cmd_start
  else info "They will be used the next time you start the server."; fi
}

gp_load() {  # copy the sandbox file into a private working copy ($GP_TMP)
  local f; f=$(sandbox_file)
  if ! as_pz test -f "$f"; then
    err "Gameplay settings file not found: $f"
    info "Run Repair (re-run setup) once so the server creates its world, then try again."
    return 1
  fi
  GP_TMP=$(mktemp "${STATE_DIR}/sandbox.XXXXXX") || return 1
  as_pz cat "$f" >"$GP_TMP" || { err "Could not read $f"; rm -f "$GP_TMP"; return 1; }
  GP_DIRTY=no; GP_SKIPPED=()
}

gp_apply_kv() {  # gp_apply_kv KEY VALUE — one option by its short name (used by the GUI)
  local k=$1 v=$2
  if [[ $k == preset ]]; then
    [[ $v =~ ^(beginner|normal|hard)$ ]] || { err "Unknown preset: $v"; return 1; }
    gp_preset "$v"; return 0
  fi
  [[ $v =~ ^([0-9]+(\.[0-9]+)?|true|false)$ ]] || { err "Bad value for $k: $v"; return 1; }
  case $k in
    zombies)   gp_pop_set "$v" ;;
    speed)     gp_set ZombieLore Speed "$v" ;;
    strength)  gp_set ZombieLore Strength "$v"; gp_set ZombieLore Toughness "$v" ;;
    infection) gp_set ZombieLore Transmission "$v" ;;
    day)       gp_set "" DayLength "$v" ;;
    xp)        gp_xp_set "$v" ;;
    loot)      gp_loot_set "$v" ;;
    utils)     gp_utils_set "$v" ;;
    night)     gp_set "" NightDarkness "$v" ;;
    injury)    gp_set "" InjurySeverity "$v" ;;
    kit)       gp_set "" StarterKit "$v" ;;
    points)    gp_set "" CharacterFreePoints "$v" ;;
    *) err "Unknown option: $k"; return 1 ;;
  esac
  return 0
}

cmd_gameplay_get() {  # prints key=value (raw values) for the GUI
  require_installed || return 1; sudo_start || return 1; gp_load || return 1
