#!/usr/bin/env bash
# =============================================================================
#  pzhost — Project Zomboid dedicated server manager for Debian 13 (also Ubuntu / Arch)
#  One app that installs, runs, backs up and troubleshoots a private
#  Build 42 server for a small group of friends (Windows + Mac clients).
#
#  Usage:  pzhost            (interactive menu)
#          pzhost help       (list all commands)
# =============================================================================

PZHOST_VERSION="1.6.1"
REPO="rohansinghwow/zomboid-host"

# ---- fixed paths -------------------------------------------------------------
PZ_USER="pz"
PZ_HOME="/home/${PZ_USER}"
SERVER_DIR="${PZ_HOME}/pzserver"
STEAMCMD_DIR="${PZ_HOME}/steamcmd"
ZOMBOID_DIR="${PZ_HOME}/Zomboid"
CONTROL="${PZ_HOME}/pzserver.control"
BACKUP_DIR="${PZ_HOME}/backups"
LIB_DIR="/usr/local/lib/pzhost"
UNIT_DIR="/etc/systemd/system"
LOGIND_DROPIN="/etc/systemd/logind.conf.d/pzhost-no-lid-sleep.conf"
SYSCTL_FILE="/etc/sysctl.d/90-pzhost.conf"
NM_WIFI_CONF="/etc/NetworkManager/conf.d/pzhost-wifi-powersave.conf"
TS_PORT=41641
SLEEP_TARGETS=(sleep.target suspend.target hibernate.target hybrid-sleep.target)
GAME_PORT=16261
UDP_PORT=16262
APP_ID=380870

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/pzhost"
CONF="${CONF_DIR}/config"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/pzhost"
LOG_FILE="${STATE_DIR}/pzhost.log"
JOIN_CARD="${HOME}/ZOMBOID_JOIN_INFO.txt"
LOCK_FILE="${STATE_DIR}/busy.lock"

set -o pipefail
set -E
# Debian keeps ufw, sysctl, iw, useradd in sbin, which is not in a normal user's PATH.
export PATH="/usr/local/sbin:/usr/sbin:/sbin:${PATH}"

# ---- GUI mode (pzhost-gui runs pzhost with PZHOST_GUI=1, stdin = /dev/null) ----
# sudo then gets the password from the app's password dialog through SUDO_ASKPASS,
# and every question silently takes its default (the app asks the user itself).
if [[ ${PZHOST_GUI:-} == 1 ]]; then
  sudo() { command sudo -A "$@"; }
fi

# ---- distro detection -------------------------------------------------------
OS_ID=$(. /etc/os-release 2>/dev/null && echo "${ID:-} ${ID_LIKE:-}")
OS_CODENAME=$(. /etc/os-release 2>/dev/null && echo "${VERSION_CODENAME:-}")
if command -v apt-get >/dev/null 2>&1; then PKG=apt
elif command -v pacman >/dev/null 2>&1; then PKG=pacman
else PKG=unknown; fi

# ---- colours -----------------------------------------------------------------
if [[ -t 1 ]]; then
  R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; B=$'\e[34m'; C=$'\e[36m'; W=$'\e[1m'; D=$'\e[2m'; N=$'\e[0m'
else
  R=; G=; Y=; B=; C=; W=; D=; N=
fi

# =============================================================================
#  Logging
# =============================================================================
mkdir -p "$STATE_DIR" "$CONF_DIR"
touch "$LOG_FILE"

log()   { printf '%s [%-5s] %s\n' "$(date '+%F %T')" "$1" "${*:2}" >>"$LOG_FILE"; }
info()  { echo "${C}•${N} $*"; log INFO "$*"; }
ok()    { echo "${G}✔${N} $*"; log OK "$*"; }
warn()  { echo "${Y}!${N} $*"; log WARN "$*"; }
err()   { echo "${R}✘ $*${N}" >&2; log ERROR "$*"; }

# Trace every failing command (with line number) into the log for debugging.
trap 'log TRACE "rc=$? line=${LINENO} func=${FUNCNAME[0]:-main} cmd=${BASH_COMMAND}"' ERR

# run CMD... — run a command, copy its full output to the screen and the log.
run() {
  log CMD "$*"
  "$@" 2>&1 | tee -a "$LOG_FILE"
  local rc=${PIPESTATUS[0]}
  log RC "$rc ← $1"
  return "$rc"
}

LAST_ERROR=""
# step "Title" func args... — one setup step with clear success/failure output.
step() {
  local title=$1; shift
  echo; echo "${B}${W}▶ ${title}${N}"; log STEP "$title"
  if "$@"; then
    echo "${G}  ✔ ${title}${N}"; log OK "step: $title"; return 0
  fi
  LAST_ERROR="$title"
  echo "${R}  ✘ ${title} — failed${N}"; log FAIL "step: $title"
  return 1
}

pause() { [[ -t 0 ]] && read -r -p "${D}Press Enter to continue…${N}" _; }

# One task at a time: the window app and the terminal menu must never run
# setup / update / start / stop at the same moment.
acquire_lock() {  # acquire_lock "what"
  command -v flock >/dev/null || return 0
  exec 9>>"$LOCK_FILE"
  if ! flock -n 9; then
    err "Zomboid Host is already busy with: $(cat "${LOCK_FILE}.info" 2>/dev/null || echo 'another task') (in another window or terminal). Wait until it has finished, then try again."
    exec 9>&-; return 1
  fi
  echo "$1" >"${LOCK_FILE}.info"
}
release_lock() {
  command -v flock >/dev/null || return 0
  flock -u 9 2>/dev/null; exec 9>&- 2>/dev/null
  return 0
}
busy_with() {  # prints what another pzhost is doing, if anything
  command -v flock >/dev/null && [[ -f $LOCK_FILE ]] || return 1
  flock -n "$LOCK_FILE" true 2>/dev/null && return 1
  cat "${LOCK_FILE}.info" 2>/dev/null || echo "a task"
}

# =============================================================================
#  Prompts
# =============================================================================
ask() {   # ask "Question" [default]  → prints answer
  local a; read -r -p "$1${2:+ [${2}]}: " a; echo "${a:-$2}"
}
ask_yn() {  # ask_yn "Question" [y|n]
  local d=${2:-n} a hint="y/N"; [[ $d == y ]] && hint="Y/n"
  read -r -p "$1 [$hint] " a; a=${a:-$d}; [[ ${a,,} == y* ]]
}
ask_secret() {  # ask_secret "Label" → prints password (letters, digits, - and _ only)
  local p p2
  while :; do
    read -r -s -p "$1 (4-32 chars: letters, digits, - or _): " p; echo >&2
    if [[ ! $p =~ ^[A-Za-z0-9_-]{4,32}$ ]]; then echo "${Y}  Not allowed — try again.${N}" >&2; continue; fi
    read -r -s -p "  Type it again: " p2; echo >&2
    [[ $p == "$p2" ]] && break
    echo "${Y}  Didn't match — try again.${N}" >&2
  done
  echo "$p"
}

# =============================================================================
#  Config
# =============================================================================
SERVER_NAME="servertest"
PZ_BRANCH="42.21"
XMX="6g"
SAVE_MINUTES="10"
JOIN_PASSWORD=""
ADMIN_PASSWORD=""
NETWORK_MODE="tailscale"     # tailscale | portforward
AUTOSTART="no"
BACKUP_KEEP_DAYS="7"
BATTERY_LIMIT="80"           # stop charging at this % (100 = no limit)
PERMISSION_GRANTED="no"
INSTALLED="no"
INSTALLED_BRANCH=""

load_config() { [[ -f $CONF ]] && source "$CONF"; }
save_config() {
  # umask only inside a subshell: a leaked 077 made sudo create /usr/local/lib/pzhost
  # as root-only, so the backup (runs as user pz) got "Permission denied".
  ( umask 077
  {
    echo "# pzhost config — written $(date '+%F %T'). Keep private (contains passwords)."
    for v in SERVER_NAME PZ_BRANCH XMX SAVE_MINUTES JOIN_PASSWORD ADMIN_PASSWORD NETWORK_MODE \
             AUTOSTART BACKUP_KEEP_DAYS BATTERY_LIMIT PERMISSION_GRANTED INSTALLED INSTALLED_BRANCH; do
      printf '%s=%q\n' "$v" "${!v}"
    done
  } >"$CONF" )
  chmod 600 "$CONF"
}

# =============================================================================
#  Permission + sudo
# =============================================================================
SUDO_KEEPALIVE_PID=""
cleanup() { [[ -n $SUDO_KEEPALIVE_PID ]] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null; }
trap cleanup EXIT

fix_lib_perms() {  # heal installs made by v1.0–1.6 (scripts folder was root-only → backups failed)
  [[ -d $LIB_DIR ]] || return 0
  if [[ $(stat -c %a "$LIB_DIR" 2>/dev/null) != 755 ]] || ! sudo -u "$PZ_USER" test -x "${LIB_DIR}/pz-backup.sh" 2>/dev/null; then
    sudo chmod 755 "$LIB_DIR" && sudo find "$LIB_DIR" -maxdepth 1 -name '*.sh' -exec chmod 755 {} + \
      && log INFO "fixed permissions of $LIB_DIR"
  fi
  local f
  for f in /usr/share/keyrings/tailscale-archive-keyring.gpg /etc/apt/sources.list.d/tailscale.list; do
    [[ -f $f && $(stat -c %a "$f" 2>/dev/null) != 644 ]] && sudo chmod 644 "$f"   # apt reads these as user _apt
  done
  return 0
}

sudo_start() {
  [[ -n $SUDO_KEEPALIVE_PID ]] && sudo -n true 2>/dev/null && return 0
  if ! command -v sudo >/dev/null; then
    err "sudo is not installed. As root run:  su -   then:  apt install sudo && usermod -aG sudo $(id -un)   then log out and back in."
    return 1
  fi
  echo "${D}Your password is needed once for this session (sudo).${N}"
  if ! sudo -v; then
    err "sudo failed. If you see \"not in the sudoers file\": run  su -  then  usermod -aG sudo $(id -un)  and log out/in."
    return 1
  fi
  ( exec 9>&-; while kill -0 $$ 2>/dev/null; do sudo -n true 2>/dev/null; sleep 50; done ) &  # 9 = busy lock
  SUDO_KEEPALIVE_PID=$!
  fix_lib_perms
}

show_permission_screen() {
  cat <<EOF

${W}════════════════════ Permission needed ════════════════════${N}
To host the Zomboid server, this app will make these changes:

 ${W}Install packages${N} (${PKG}): $(pkg_list | tr '\n' ' ')
                   + tailscale (if chosen; on Debian/Ubuntu this adds
                     Tailscale's official apt repository)
 ${W}Create a system user${N} "${PZ_USER}" (home ${PZ_HOME}) that runs the server
 ${W}Download${N} SteamCMD + Project Zomboid server (~5 GB) into ${PZ_HOME}
 ${W}Create services${N}: pzserver (server), pzbackup (daily 05:00),
                   pzrestart (daily 05:10 restart, only if running)
 ${W}Power settings${N}: laptop will NOT sleep when the lid is closed,
                   sleep/suspend/hibernate are disabled
 ${W}Laptop server mode${N}: battery stops charging at ${BATTERY_LIMIT}% (if the laptop
                   supports it), Wi-Fi password stored system-wide so Wi-Fi
                   connects at boot without login and keeps retrying,
                   Wi-Fi power saving off (also in the Wi-Fi driver), and a
                   watchdog that reconnects Wi-Fi if the internet drops
 ${W}Firewall${N}: open UDP ${GAME_PORT}-${UDP_PORT} (+ ${TS_PORT} for Tailscale direct)
 ${W}Low-ping tuning${N}: Wi-Fi power saving OFF, bigger UDP buffers (sysctl),
                   server runs at higher priority, "performance" power
                   profile only while the server is running
 ${W}Tailscale${N}: enable the tailscaled service and log in (if chosen)
 ${W}Files${N}: settings in ${CONF_DIR}, logs in ${STATE_DIR},
        join info in ${JOIN_CARD}

Everything can be undone with: pzhost uninstall
${W}═══════════════════════════════════════════════════════════${N}
EOF
}

ensure_permission() {
  if [[ $PERMISSION_GRANTED != yes && ${PZHOST_GUI:-} == 1 && ${PZHOST_GRANT:-} == yes ]]; then
    PERMISSION_GRANTED=yes; save_config; log INFO "Permission granted in the app by user $(id -un)"
  fi
  if [[ $PERMISSION_GRANTED != yes ]]; then
    show_permission_screen
    local a; read -r -p "Type ${W}yes${N} to allow all of the above: " a
    if [[ ${a,,} != yes ]]; then err "Permission not given — nothing was changed."; return 1; fi
    PERMISSION_GRANTED=yes; save_config
    log INFO "Permission granted by user $(id -un)"
  fi
  sudo_start
}

# =============================================================================
#  Helpers
# =============================================================================
as_pz() { ( cd / && sudo -u "$PZ_USER" -H "$@" ); }
server_active() { systemctl is-active -q pzserver.service; }
total_ram_gb() { awk '/MemTotal/ {printf "%d", ($2/1024/1024)+0.5}' /proc/meminfo; }
local_ip() { ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'; }
gateway_ip() { ip -4 route show default 2>/dev/null | awk '{print $3; exit}'; }
public_ip() { curl -4 -fsS --max-time 8 https://ifconfig.me 2>/dev/null || curl -4 -fsS --max-time 8 https://api.ipify.org 2>/dev/null; }
tailscale_ip() { command -v tailscale >/dev/null || return 1; tailscale ip -4 2>/dev/null | head -1; }
is_cgnat_ip() { local a b; IFS=. read -r a b _ _ <<<"$1"; [[ $a == 100 ]] && (( b >= 64 && b <= 127 )); }
is_private_ip() {
  local a b; IFS=. read -r a b _ _ <<<"$1"
  [[ $a == 10 ]] || { [[ $a == 172 ]] && (( b >= 16 && b <= 31 )); } || [[ $a.$b == 192.168 ]] || is_cgnat_ip "$1"
}

require_installed() {
  if [[ $INSTALLED != yes ]]; then err "Server is not installed yet. Run Setup first (pzhost setup)."; return 1; fi
}

send_console() {  # send a console command to the running server
  server_active || { err "Server is not running."; return 1; }
  printf '%s\n' "$1" | sudo tee "$CONTROL" >/dev/null && log INFO "console ← $1"
}

set_ini() {  # set_ini KEY VALUE — replace in place or append (only writes when different)
  local f="${ZOMBOID_DIR}/Server/${SERVER_NAME}.ini" k=$1 v=$2 cur
  cur=$(as_pz grep -m1 "^${k}=" "$f" 2>/dev/null) && [[ ${cur#*=} == "$v" ]] && return 0
  INI_CHANGED=yes
  if as_pz grep -q "^${k}=" "$f"; then
    as_pz sed -i "s|^${k}=.*|${k}=${v}|" "$f"
  else
    printf '%s=%s\n' "$k" "$v" | as_pz tee -a "$f" >/dev/null
  fi
  log INFO "ini: ${k} set"
}

# =============================================================================
#  Setup steps
# =============================================================================
setup_questions() {
  echo; echo "${W}A few questions first (Enter = default):${N}"

  PZ_BRANCH=$(ask "Game version / Steam branch (must match ALL friends' game version)" "$PZ_BRANCH")

  local ram; ram=$(total_ram_gb)
  echo "  Detected ${ram} GB RAM."
  if ask_yn "  Will you also PLAY the game on this same laptop?" y; then
    (( ram >= 15 )) && XMX="6g" || XMX="3g"
  else
    (( ram >= 15 )) && XMX="8g" || XMX="4g"
  fi
  XMX=$(ask "  Server memory (-Xmx)" "$XMX")

  SAVE_MINUTES=$(ask "Auto-save the world every N minutes" "$SAVE_MINUTES")

  if [[ -z $JOIN_PASSWORD ]] || ask_yn "Change the join password your friends type?" n; then
    JOIN_PASSWORD=$(ask_secret "Join password for friends")
  fi
  if [[ -z $ADMIN_PASSWORD ]]; then
    ADMIN_PASSWORD=$(ask_secret "Admin password (different from join password, only for you)")
  fi

  echo
  echo "How will friends reach this laptop?"
  echo "  1) Tailscale  ${G}(recommended — works with Jio CGNAT, nothing to change on router)${N}"
  echo "  2) Router port forwarding (only works if Jio gives you a real public IP)"
  local n; n=$(ask "Choose" "$([[ $NETWORK_MODE == portforward ]] && echo 2 || echo 1)")
  [[ $n == 2 ]] && NETWORK_MODE=portforward || NETWORK_MODE=tailscale

  ask_yn "Start the server automatically when the laptop boots?" n && AUTOSTART=yes || AUTOSTART=no
  save_config
}

setup_from_gui() {  # answers come from the app's setup form (environment variables)
  [[ -n ${GUI_BRANCH:-} ]] && { [[ $GUI_BRANCH =~ ^[A-Za-z0-9._-]+$ ]] || { err "Bad game version"; return 1; }; PZ_BRANCH=$GUI_BRANCH; }
  [[ -n ${GUI_XMX:-} ]] && { [[ $GUI_XMX =~ ^[0-9]+[gm]$ ]] || { err "Bad memory value"; return 1; }; XMX=$GUI_XMX; }
  [[ -n ${GUI_JOIN_PASSWORD:-} ]] && JOIN_PASSWORD=$GUI_JOIN_PASSWORD
  [[ -n ${GUI_ADMIN_PASSWORD:-} && -z $ADMIN_PASSWORD ]] && ADMIN_PASSWORD=$GUI_ADMIN_PASSWORD
  [[ ${GUI_NETWORK:-} =~ ^(tailscale|portforward)$ ]] && NETWORK_MODE=$GUI_NETWORK
  [[ ${GUI_AUTOSTART:-} =~ ^(yes|no)$ ]] && AUTOSTART=$GUI_AUTOSTART
  local p
  for p in "$JOIN_PASSWORD" "$ADMIN_PASSWORD"; do
    [[ $p =~ ^[A-Za-z0-9_-]{4,32}$ ]] || { err "Passwords must be 4-32 letters, digits, - or _"; return 1; }
  done
  save_config
}

preflight() {
  local id_like; id_like=$(. /etc/os-release && echo "${ID} ${ID_LIKE:-}")
  info "OS: $(. /etc/os-release && echo "$PRETTY_NAME"), kernel $(uname -r)"
  [[ $id_like == *debian* || $id_like == *ubuntu* || $id_like == *arch* ]] \
    || { err "This app supports Debian 13 / Ubuntu / Arch Linux."; return 1; }
  [[ $PKG != unknown ]] || { err "Neither apt nor pacman found."; return 1; }
  command -v systemctl >/dev/null || { err "systemd not found."; return 1; }
  [[ $(uname -m) == x86_64 ]] || { err "x86_64 CPU required (found $(uname -m))."; return 1; }

  local cpu ram free_gb
  cpu=$(awk -F: '/model name/ {gsub(/^ +/,"",$2); print $2; exit}' /proc/cpuinfo)
  ram=$(total_ram_gb)
  free_gb=$(df -BG --output=avail /home | tail -1 | tr -dc '0-9')
  info "CPU: ${cpu} ($(nproc) threads) · RAM: ${ram} GB · Free on /home: ${free_gb} GB"
  (( ram < 8 )) && warn "Less than 8 GB RAM — the server may run out of memory."
  (( free_gb < 15 )) && { err "Need at least 15 GB free disk space on /home."; return 1; }

  if ls /sys/class/power_supply/A{C,DP}*/online >/dev/null 2>&1; then
    grep -q 1 /sys/class/power_supply/A{C,DP}*/online 2>/dev/null || warn "Laptop is on battery — plug in the charger for hosting."
  fi

  if server_files_current; then
    ok "Server files already installed — nothing to download"
    return 0
  fi
  info "Checking internet / Steam CDN…"
  curl -fsS --max-time 15 -r 0-99 -o /dev/null \
    https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz \
    || { err "Cannot reach the Steam download server. Check the internet connection."; return 1; }
  ok "Internet OK"
}

pkg_list() {  # base packages for this distro
  if [[ $PKG == apt ]]; then
    printf '%s\n' lib32gcc-s1 curl tar ca-certificates git gh iputils-ping iproute2 procps iw
  else
    printf '%s\n' lib32-gcc-libs curl tar git github-cli iputils iproute2 procps-ng iw
  fi
}

pkg_installed() {
  if [[ $PKG == apt ]]; then dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q "install ok installed"
  else pacman -Qi "$1" >/dev/null 2>&1; fi
}

pkg_install() {  # pkg_install PKG...
  if [[ $PKG == apt ]]; then
    run sudo apt-get update || return 1
    run sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$@"
  else
    run sudo pacman -S --needed --noconfirm "$@" && return 0
    warn "Install failed — package database may be out of date. Running a full system update and retrying…"
    run sudo pacman -Syu --noconfirm && run sudo pacman -S --needed --noconfirm "$@"
  fi
}

add_tailscale_repo() {  # Debian/Ubuntu: Tailscale is not in the distro repos
  [[ -f /etc/apt/sources.list.d/tailscale.list ]] && return 0
  local distro=debian code=${OS_CODENAME:-trixie}
  [[ $OS_ID == ubuntu* || $OS_ID == *" ubuntu"* ]] && distro=ubuntu
  local base="https://pkgs.tailscale.com/stable/${distro}/${code}"
  info "Adding Tailscale apt repository (${distro} ${code})…"
  if ! curl -fsSL "${base}.noarmor.gpg" -o /dev/null; then
    warn "Tailscale has no repo for '${code}' — falling back to Debian bookworm packages."
    distro=debian; code=bookworm; base="https://pkgs.tailscale.com/stable/${distro}/${code}"
  fi
  curl -fsSL "${base}.noarmor.gpg" | sudo tee /usr/share/keyrings/tailscale-archive-keyring.gpg >/dev/null || return 1
  curl -fsSL "${base}.tailscale-keyring.list" | sudo tee /etc/apt/sources.list.d/tailscale.list >/dev/null || return 1
  sudo chmod 644 /usr/share/keyrings/tailscale-archive-keyring.gpg /etc/apt/sources.list.d/tailscale.list
  log INFO "tailscale repo: ${base}"
}

install_packages() {
  local pkgs=() missing=() p
  mapfile -t pkgs < <(pkg_list)
  [[ $NETWORK_MODE == tailscale ]] && pkgs+=(tailscale)
  for p in "${pkgs[@]}"; do pkg_installed "$p" || missing+=("$p"); done
  if (( ${#missing[@]} == 0 )); then ok "All packages already installed"; return 0; fi
  if [[ $PKG == apt && " ${missing[*]} " == *" tailscale "* ]]; then
    add_tailscale_repo || { err "Could not add the Tailscale repository."; return 1; }
  fi
  info "Installing: ${missing[*]}"
  pkg_install "${missing[@]}"
}

create_user() {
  if id "$PZ_USER" >/dev/null 2>&1; then ok "User ${PZ_USER} exists"; return 0; fi
  run sudo useradd -m -s /bin/bash "$PZ_USER"
}

install_steamcmd() {
  if as_pz test -x "${STEAMCMD_DIR}/steamcmd.sh"; then ok "SteamCMD already installed"; return 0; fi
  as_pz mkdir -p "$STEAMCMD_DIR" || return 1
  run as_pz bash -c "cd '${STEAMCMD_DIR}' && curl -fsSL https://steamcdn-a.akamaihd.net/client/installer/steamcmd_linux.tar.gz | tar zxf -"
}

show_branches() {
  info "Asking Steam for the list of available versions (branches)…"
  as_pz "${STEAMCMD_DIR}/steamcmd.sh" +login anonymous +app_info_update 1 +app_info_print "$APP_ID" +quit 2>&1 \
    | tee -a "$LOG_FILE" \
    | awk '/"branches"/{f=1;next} f && /^[\t ]*"[^"]+"[\t ]*$/ {gsub(/[\t "]/,""); print "   - " $0}' \
    | head -40
}

# ---- what is installed? (read from Steam's own manifest, not just our config)
server_manifest() { as_pz cat "${SERVER_DIR}/steamapps/appmanifest_${APP_ID}.acf" 2>/dev/null; }
installed_build() { server_manifest | awk -F'"' 'tolower($2)=="buildid" {print $4; exit}'; }
installed_branch() {
  local m b; m=$(server_manifest) || return 1
  [[ -n $m ]] || return 1
  b=$(awk -F'"' 'tolower($2)=="betakey" {print $4; exit}' <<<"$m")
  echo "${b:-public}"
}
server_files_ok() { id -u "$PZ_USER" >/dev/null 2>&1 && as_pz test -x "${SERVER_DIR}/start-server.sh" && as_pz test -f "${SERVER_DIR}/ProjectZomboid64.json"; }
server_files_current() {  # installed files are the wanted version → no download needed
  server_files_ok || return 1
  local have; have=$(installed_branch) || have=""
  if [[ -n $have ]]; then [[ $have == "${PZ_BRANCH:-public}" ]]
  else [[ $INSTALLED_BRANCH == "$PZ_BRANCH" ]]; fi
}
steam_latest_build() {  # newest build id of a branch, asked from Steam
  as_pz "${STEAMCMD_DIR}/steamcmd.sh" +login anonymous +app_info_update 1 +app_info_print "$APP_ID" +quit 2>/dev/null \
    | awk -F'"' -v br="${1:-public}" '$2=="branches"{inb=1} inb && $2==br && NF<=3 {f=1} f && $2=="buildid" {print $4; exit}'
}

# PZ servers that were NOT started by this app (by hand, or the game's own "Host"
# button) hold the ports, so ours can't start. Stop them first.
stop_stray_servers() {
  command -v pgrep >/dev/null || return 0
  local p stray=()
  for p in $(pgrep -f 'zombie\.network\.GameServer|ProjectZomboid64.*-servername' 2>/dev/null); do
    grep -qs 'pzserver\.service' "/proc/$p/cgroup" && continue
    stray+=("$p")
  done
  (( ${#stray[@]} )) || return 0
  warn "Another Zomboid server is already running outside this app (PID ${stray[*]}) — stopping it so the ports are free."
  sudo kill -TERM "${stray[@]}" 2>/dev/null
  local i
  for i in $(seq 1 30); do
    sleep 1
    for p in "${stray[@]}"; do [[ -d /proc/$p ]] && continue 2; done
    ok "Old server stopped"; return 0
  done
  sudo kill -KILL "${stray[@]}" 2>/dev/null
  ok "Old server stopped (forced)"
}

install_server() {  # install_server [repair|update] — downloads only when needed
  local mode=${1:-}
  if [[ -z $mode ]] && server_files_current; then
    INSTALLED_BRANCH="$PZ_BRANCH"; save_config
    ok "Server files already installed (version ${PZ_BRANCH}, build $(installed_build || echo '?')) — no download needed"
    return 0
  fi
  if server_active; then
    warn "The server is running — stopping it first so its files can be replaced."
    send_console 'servermsg "Server is stopping for an update. Back in a few minutes."' 2>/dev/null; sleep 5
    info "Saving world and stopping (about 20 seconds)…"
    run sudo systemctl stop pzserver.service || return 1
  fi
  stop_stray_servers
  local beta=() out attempt validate=()
  [[ -n $PZ_BRANCH && $PZ_BRANCH != public ]] && beta=(-beta "$PZ_BRANCH")
  # Full file check only for a first install or an explicit repair (it re-reads all ~5 GB).
  if [[ $mode == repair ]] || ! server_files_ok; then validate=(validate); fi
  out=$(mktemp)
  for attempt in 1 2 3; do
    info "Downloading server (version ${PZ_BRANCH}), attempt ${attempt}/3 — this can take a while…"
    as_pz "${STEAMCMD_DIR}/steamcmd.sh" +force_install_dir "$SERVER_DIR" +login anonymous \
      +app_update "$APP_ID" "${beta[@]}" "${validate[@]}" +quit 2>&1 | tee -a "$LOG_FILE" "$out"
    if grep -q "Success! App '${APP_ID}'" "$out"; then
      INSTALLED_BRANCH="$PZ_BRANCH"; save_config; rm -f "$out"; NEED_RESTART=yes; return 0
    fi
    if grep -qiE "invalid beta|beta.*(not found|doesn't exist)|Invalid platform" "$out"; then
      err "Steam says version/branch '${PZ_BRANCH}' does not exist."
      show_branches
      echo "${Y}Pick one of the names above in Settings → Game version, then run Repair.${N}"
      rm -f "$out"; return 1
    fi
    sleep 3
  done
  rm -f "$out"
  err "SteamCMD did not finish the download after 3 attempts (see log)."
  return 1
}

set_xmx() {
  local f="${SERVER_DIR}/ProjectZomboid64.json"
  as_pz test -f "$f" || { err "Missing $f"; return 1; }
  if as_pz grep -q "\"-Xmx${XMX}\"" "$f"; then ok "Server memory already ${XMX}"; return 0; fi
  NEED_RESTART=yes
  as_pz sed -E -i "s/\"-Xmx[0-9]+[gGmM]\"/\"-Xmx${XMX}\"/" "$f" || return 1
  as_pz grep -q "\"-Xmx${XMX}\"" "$f" || { err "Could not set -Xmx in $f"; return 1; }
  ok "Server memory set to ${XMX}"
}

write_if_changed() {  # write_if_changed FILE < content — server restart only if the service really changed
  local tmp; tmp=$(mktemp)
  cat >"$tmp"
  if sudo cmp -s "$tmp" "$1"; then rm -f "$tmp"; return 0; fi
  sudo install -m 644 "$tmp" "$1"; rm -f "$tmp"
  [[ $1 == *pzserver* ]] && NEED_RESTART=yes
  log INFO "updated $1"
  return 0
}

