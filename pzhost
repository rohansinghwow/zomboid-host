  info "First start: creating the world and admin account (can take 5–20 minutes)…"
  local dropin="${UNIT_DIR}/pzserver.service.d/10-firstrun.conf" ts rc=0
  sudo mkdir -p "$(dirname "$dropin")"
  sudo tee "$dropin" >/dev/null <<EOF
