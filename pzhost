#  Network check (Jio CGNAT)
# =============================================================================
cmd_netcheck() {
  echo; echo "${W}── Network check ──${N}"
  local lip gw pub wan
  lip=$(local_ip); gw=$(gateway_ip); pub=$(public_ip)
  echo "  This laptop (LAN) : ${lip:-?}"
  echo "  Router            : ${gw:-?}"
  echo "  Public IP (seen by internet): ${pub:-could not detect}"
  if [[ -n $pub ]] && is_cgnat_ip "$pub"; then
    warn "Your public IP is in the CGNAT range — port forwarding will NOT work. Use Tailscale."
    return 0
  fi
  echo
  echo "  Open ${C}http://${gw:-192.168.29.1}${N} in a browser, log in, and find the"
  echo "  ${W}WAN IPv4${N} / Internet IP on the status page."
  wan=$(ask "  Type that WAN IPv4 here (Enter to skip)" "")
  log INFO "netcheck: wan_entered=$([[ -n $wan ]] && echo yes || echo no)"
  if [[ -z $wan ]]; then
    info "Skipped. If friends can't connect with port forwarding, switch to Tailscale in Settings."
  elif [[ $wan == "$pub" ]]; then
    ok "WAN IP matches public IP — you have a real public IP. Port forwarding can work."
    cat <<EOF

  ${W}Router port forwarding:${N}
   1. Router page → LAN / DHCP → reserve ${lip:-the laptop IP} for this laptop
   2. Router page → NAT / Security → Port Forwarding (name varies), add:
        UDP ${GAME_PORT} → ${lip:-LAN IP}:${GAME_PORT}
        UDP ${UDP_PORT} → ${lip:-LAN IP}:${UDP_PORT}
   3. Friends use the public IP: ${pub}
EOF
  elif is_private_ip "$wan"; then
    warn "Router's WAN IP ($wan) is private → Jio CGNAT. Port forwarding will NOT work. Use Tailscale."
  else
    warn "WAN IP differs from public IP → CGNAT. Port forwarding will NOT work. Use Tailscale."
  fi
}

