  esac
}
gp_kit_label() { case $(gp_get "" StarterKit) in true) echo "Yes" ;; false) echo "No" ;; *) echo "?" ;; esac; }
gp_points_label() { local v; v=$(gp_get "" CharacterFreePoints) || { echo "?"; return; }; echo "+${v}"; }

gp_preset() {
  case $1 in
    beginner)
