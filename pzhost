# =============================================================================
#  Laptop server mode: battery charge limit + Wi-Fi that survives reboots
# =============================================================================
BATTERY_SCRIPT="${LIB_DIR}/battery-limit.sh"
BATTERY_UNIT="${UNIT_DIR}/pzbattery.service"

battery_present() { ls -d /sys/class/power_supply/BAT* >/dev/null 2>&1; }
on_ac() { grep -qs 1 /sys/class/power_supply/A{C,DP}*/online; }
battery_limit_now() {  # prints the active limit, or nothing if not supported
  local b
  for b in /sys/class/power_supply/BAT*; do
    [[ -r $b/charge_control_end_threshold ]] && { cat "$b/charge_control_end_threshold"; return 0; }
  done
  for b in /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode; do
    [[ -r $b ]] && { [[ $(cat "$b") == 1 ]] && echo "conservation" || echo 100; return 0; }
  done
  return 1
}
battery_supported() { battery_limit_now >/dev/null; }

battery_limit_apply() {  # battery_limit_apply PERCENT (100 = no limit)
  local pct=${1:-$BATTERY_LIMIT}
  battery_present || { ok "No battery found — nothing to limit"; return 0; }
  if ! battery_supported; then
    warn "This laptop does not let Linux limit battery charging."
    info "Most laptops have it in the BIOS/UEFI setup instead (press F2/F10/Del at power-on). Look for:"
    echo "    Dell: 'Primary Battery Charge Configuration' → Custom 50-80%"
    echo "    HP:   'Battery Health Manager' → Maximize my battery health"
    echo "    Lenovo: 'Battery conservation' · ASUS: 'Battery Health Charging' · Acer: 'Battery charge limit'"
    info "Laptop: $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) $(cat /sys/class/dmi/id/product_name 2>/dev/null)"
    return 0
  fi
  sudo mkdir -p "$LIB_DIR"
  sudo tee "$BATTERY_SCRIPT" >/dev/null <<'EOF'
#!/bin/sh
# pzhost: cap battery charging — the laptop stays plugged in 24/7 as a server.
# Usage: battery-limit.sh PERCENT   (100 = normal charging)
END=${1:-80}; START=$((END - 5)); done=0
for b in /sys/class/power_supply/BAT*; do
  [ -d "$b" ] || continue
  if [ -w "$b/charge_types" ] && grep -q Custom "$b/charge_types"; then   # Dell
    if [ "$END" -lt 100 ]; then echo Custom > "$b/charge_types"; else echo Standard > "$b/charge_types"; fi 2>/dev/null
  fi
  if [ -e "$b/charge_control_end_threshold" ]; then
    # Some drivers need start < end at every moment, so write both twice.
    for i in 1 2; do
      echo "$END" > "$b/charge_control_end_threshold" 2>/dev/null
      [ -e "$b/charge_control_start_threshold" ] && echo "$START" > "$b/charge_control_start_threshold" 2>/dev/null
    done
    if [ "$(cat "$b/charge_control_end_threshold")" = "$END" ]; then
      echo "$(basename "$b"): charging stops at ${END}%"; done=1
    fi
  fi
done
if [ $done = 0 ]; then
  for c in /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode; do   # Lenovo IdeaPad
    [ -e "$c" ] || continue
    if [ "$END" -lt 100 ]; then v=1; else v=0; fi
    echo $v > "$c" && { echo "Lenovo conservation mode = $v (1 = charging stops at about 60-80%)"; done=1; }
  done
fi
[ $done = 1 ] || { echo "Could not set a battery charge limit on this laptop."; exit 2; }
EOF
  sudo chmod 755 "$BATTERY_SCRIPT"
  sudo tee "$BATTERY_UNIT" >/dev/null <<EOF
[Unit]
Description=pzhost: limit laptop battery charge to ${pct}%
After=multi-user.target

[Service]
Type=oneshot
ExecStart=${BATTERY_SCRIPT} ${pct}
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  sudo systemctl daemon-reload
  if [[ $pct -ge 100 ]]; then
    run sudo "$BATTERY_SCRIPT" 100; sudo systemctl disable pzbattery.service >/dev/null 2>&1
    ok "Battery charges normally to 100%"
  else
    run sudo "$BATTERY_SCRIPT" "$pct" || { warn "The battery driver refused the limit."; return 0; }
    sudo systemctl enable pzbattery.service >/dev/null 2>&1   # re-applied at every boot
    ok "Battery limit ${pct}% (kept after reboot). If it is above ${pct}% now, it slowly drains down to it."
  fi
}

wifi_system_wide() {  # Wi-Fi connects at boot without anyone logging in, and never gives up retrying
  command -v nmcli >/dev/null || { ok "NetworkManager not used — skipping"; return 0; }
  local dev con; dev=$(wifi_iface)
  [[ -n $dev ]] || { ok "Using a cable (Ethernet) — Wi-Fi setup not needed"; return 0; }
  con=$(nmcli -g GENERAL.CONNECTION device show "$dev" 2>/dev/null)
  [[ -n $con ]] || { warn "Wi-Fi is not connected — connect to your Wi-Fi first, then run this again."; return 0; }
  local args=(connection.autoconnect yes connection.autoconnect-retries 0 connection.permissions "")
  local km flags psk
  km=$(nmcli -g 802-11-wireless-security.key-mgmt connection show "$con" 2>/dev/null)
  flags=$(nmcli -g 802-11-wireless-security.psk-flags connection show "$con" 2>/dev/null)
  if [[ $km == wpa-psk || $km == sae ]] && [[ -n $flags && $flags != 0* ]]; then
    # Password lives in the user's keyring → unavailable before login. Store it system-wide.
    psk=$(nmcli -s -g 802-11-wireless-security.psk connection show "$con" 2>/dev/null)
    if [[ -n $psk ]]; then args+=(802-11-wireless-security.psk "$psk" 802-11-wireless-security.psk-flags 0)
    else warn "Could not read the Wi-Fi password (run this from the laptop's desktop, not over SSH)."; fi
  fi
  sudo nmcli connection modify "$con" "${args[@]}" || { warn "Could not change the Wi-Fi connection."; return 0; }
  log INFO "wifi '$con': system-wide, autoconnect, infinite retries"
  ok "Wi-Fi '${con}' reconnects by itself after reboots and drop-outs (no login needed)"
}

WIFI_MODPROBE="/etc/modprobe.d/pzhost-wifi.conf"
WIFI_WATCHDOG="${LIB_DIR}/wifi-watchdog.sh"

wifi_stability() {  # Wi-Fi must never doze off or stay dead
  local w con drv opts=""
  w=$(wifi_iface)
  if [[ -z $w ]] && command -v nmcli >/dev/null; then
    w=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')
  fi
  [[ -n $w ]] || { ok "No Wi-Fi adapter in use — nothing to do"; return 0; }
  # 1) power saving off for this exact connection (on top of the global NetworkManager setting)
  if command -v nmcli >/dev/null; then
    con=$(nmcli -g GENERAL.CONNECTION device show "$w" 2>/dev/null)
    [[ -n $con ]] && sudo nmcli connection modify "$con" 802-11-wireless.powersave 2 2>/dev/null \
      && ok "Wi-Fi power saving off for '${con}'"
  fi
  command -v iw >/dev/null && sudo iw dev "$w" set power_save off 2>/dev/null
  # 2) power saving off inside the Wi-Fi chip driver (fully active after the next reboot)
  drv=$(basename "$(readlink -f "/sys/class/net/$w/device/driver" 2>/dev/null)" 2>/dev/null)
  case $drv in
    iwlwifi)         opts=$'options iwlwifi power_save=0\noptions iwlmvm power_scheme=1' ;;
    rtw88_*)         opts=$'options rtw88_pci disable_aspm=1\noptions rtw88_core disable_lps_deep=1' ;;
    rtw89_*)         opts=$'options rtw89_pci disable_aspm_l1=1 disable_aspm_l1ss=1\noptions rtw89_core disable_ps_mode=1' ;;
    mt7921e|mt7925e) opts="options ${drv} disable_aspm=1" ;;
  esac
  if [[ -n $opts ]]; then
    printf '# pzhost: keep the Wi-Fi chip fully awake (server)\n%s\n' "$opts" | sudo tee "$WIFI_MODPROBE" >/dev/null
    ok "Wi-Fi chip (${drv}) power saving off — fully active after the next reboot"
  else
    info "Wi-Fi chip driver: ${drv:-unknown} (no extra driver tweak needed)"
  fi
  # 3) watchdog: if the internet is gone for ~3 minutes, reconnect Wi-Fi by itself
  sudo mkdir -p "$LIB_DIR"
  sudo tee "$WIFI_WATCHDOG" >/dev/null <<'EOF'
#!/bin/sh
# pzhost Wi-Fi watchdog (runs every minute). If Wi-Fi is the connection in use and
# neither the router nor the internet answers for 3 checks in a row, reconnect it.
STATE=/run/pzhost-wifi-fails
dev=$(ip -4 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
[ -n "$dev" ] || dev=$(nmcli -t -f DEVICE,TYPE device 2>/dev/null | awk -F: '$2=="wifi"{print $1; exit}')
if [ -z "$dev" ] || [ ! -d "/sys/class/net/$dev/wireless" ]; then rm -f "$STATE"; exit 0; fi
gw=$(ip -4 route show default dev "$dev" 2>/dev/null | awk '{print $3; exit}')
if { [ -n "$gw" ] && ping -n -c 2 -W 3 "$gw" >/dev/null 2>&1; } || ping -n -c 2 -W 3 1.1.1.1 >/dev/null 2>&1; then
  [ -f "$STATE" ] && echo "Connection is back."
  rm -f "$STATE"; exit 0
fi
n=$(( $(cat "$STATE" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$STATE"
echo "No connection on $dev (check $n)"
nmcli radio wifi on 2>/dev/null
if [ "$n" -eq 3 ] || [ $(( n % 10 )) -eq 0 ]; then
  echo "Reconnecting Wi-Fi $dev"; nmcli device disconnect "$dev" >/dev/null 2>&1; sleep 2; nmcli device connect "$dev"
elif [ "$n" -eq 6 ]; then
  echo "Restarting NetworkManager"; systemctl restart NetworkManager
fi
exit 0
EOF
  sudo chmod 755 "$WIFI_WATCHDOG"
  sudo tee "${UNIT_DIR}/pzwifi-watchdog.service" >/dev/null <<EOF
[Unit]
Description=pzhost: reconnect Wi-Fi if the internet is down
After=NetworkManager.service

[Service]
Type=oneshot
ExecStart=${WIFI_WATCHDOG}
EOF
  sudo tee "${UNIT_DIR}/pzwifi-watchdog.timer" >/dev/null <<'EOF'
[Unit]
Description=pzhost: Wi-Fi watchdog every minute

[Timer]
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=10s

[Install]
WantedBy=timers.target
EOF
  sudo systemctl daemon-reload
  run sudo systemctl enable --now pzwifi-watchdog.timer || return 0
  ok "Wi-Fi watchdog on: reconnects by itself if the internet drops for ~3 minutes"
  return 0
}

